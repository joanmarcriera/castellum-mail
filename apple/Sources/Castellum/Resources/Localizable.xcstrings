        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se muestra la selección sincronizada actual, solo lectura. Arregla la conexión (Volver a autenticar…) y vuelve a abrir Carpetas… para cambiarla."
          }
        }
      }
    },
    "Using the default folder set: Inbox, Sent, Drafts, Trash, Junk and subscribed folders." : {
      "localizations" : {
