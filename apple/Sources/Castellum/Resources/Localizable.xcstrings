    "Choose a single account under Apply to for “Move to…”." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tria un sol compte a «Aplica a» per a «Mou a…»."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a single account under Apply to for “Move to…”."
          }
        },
