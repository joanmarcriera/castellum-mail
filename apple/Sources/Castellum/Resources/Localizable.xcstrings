          }
        }
      }
    },
    "Replies use the address the message was sent to, when it is one of your identities. Reply-To and Bcc apply to every message sent from this identity; the Bcc is never shown in the headers." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les respostes fan servir l'adreça a la qual es va enviar el missatge, si és una de les teves identitats. Respon a i Cco s'apliquen a tots els missatges enviats des d'aquesta identitat; la Cco mai no apareix a les capçaleres."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Replies use the address the message was sent to, when it is one of your identities. Reply-To and Bcc apply to every message sent from this identity; the Bcc is never shown in the headers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas usan la dirección a la que se envió el mensaje, si es una de tus identidades. Responder a y Cco se aplican a todos los mensajes enviados desde esta identidad; la Cco nunca aparece en las cabeceras."
          }
        }
      }
    },
