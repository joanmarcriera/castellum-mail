    "Wraps plain-text mail with soft line breaks (RFC 3676) so it reads well in any client and re-flows on narrow screens. Markdown mail is not affected." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plega el correu de text pla amb salts de línia suaus (RFC 3676) perquè es llegeixi bé a qualsevol client i s'ajusti a pantalles estretes. El correu en Markdown no es veu afectat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wraps plain-text mail with soft line breaks (RFC 3676) so it reads well in any client and re-flows on narrow screens. Markdown mail is not affected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el correo de texto plano con saltos de línea suaves (RFC 3676) para que se lea bien en cualquier cliente y se adapte a pantallas estrechas. El correo en Markdown no se ve afectado."
          }
        }
      }
    },
    "Warn when a message mentions an attachment but has none" : {
      "localizations" : {
