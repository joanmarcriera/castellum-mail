          "stringUnit" : {
            "state" : "translated",
            "value" : "Este proveedor solo permite iniciar sesión con su propio acceso web (OAuth), que Castellum aún no admite."
          }
        }
      }
    },
    "This provider only offers unencrypted IMAP, so Castellum won’t fill it in. You can still enter the servers yourself." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest proveïdor només ofereix IMAP sense xifrar, així que Castellum no l’omplirà. Pots introduir els servidors tu mateix."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This provider only offers unencrypted IMAP, so Castellum won’t fill it in. You can still enter the servers yourself."
