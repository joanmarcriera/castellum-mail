    "The key is valid, but Castellum could not save it to the Keychain. Unlock your Keychain and try again." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clau és vàlida, però Castellum no l'ha pogut desar al clauer. Desbloqueja el clauer i torna-ho a provar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key is valid, but Castellum could not save it to the Keychain. Unlock your Keychain and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave es válida, pero Castellum no ha podido guardarla en el llavero. Desbloquea el llavero e inténtalo de nuevo."
