    "These folders have changes not yet sent to the server: %@. Sync now so they go through (changes that already failed permanently are not retried by syncing), or discard them and remove the folder(s) anyway." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquestes carpetes tenen canvis que encara no s'han enviat al servidor: %@. Sincronitza ara perquè s'enviïn (els canvis que ja han fallat de manera definitiva no es tornen a provar en sincronitzar) o descarta'ls i elimina igualment les carpetes."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These folders have changes not yet sent to the server: %@. Sync now so they go through (changes that already failed permanently are not retried by syncing), or discard them and remove the folder(s) anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas carpetas tienen cambios que aún no se han enviado al servidor: %@. Sincroniza ahora para que se envíen (los cambios que ya han fallado de forma definitiva no se reintentan al sincronizar) o descártalos y quita igualmente las carpetas."
          }
        }
      }
    },
