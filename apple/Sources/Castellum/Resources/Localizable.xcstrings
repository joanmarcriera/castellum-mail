    "%1$@ still has %2$@ unsent outbox draft(s) and %3$@ pending change(s) not yet sent to the server. Resetting now discards them — any message still sending will NOT be delivered." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ encara té %2$@ esborrany(s) sense enviar a la safata de sortida i %3$@ canvi(s) pendent(s) sense enviar al servidor. Si ho reinicies ara, es descartaran; cap missatge que s'estigui enviant es lliurarà."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ still has %2$@ unsent outbox draft(s) and %3$@ pending change(s) not yet sent to the server. Resetting now discards them — any message still sending will NOT be delivered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ todavía tiene %2$@ borrador(es) sin enviar en la bandeja de salida y %3$@ cambio(s) pendiente(s) sin enviar al servidor. Si lo reinicias ahora, se descartarán; ningún mensaje que se esté enviando se entregará."
          }
        }
      }
    },
    "%@ was not applied: %@ is in evaluation mode, so Castellum makes no changes to the mail server.\n\nEnable writes for this account to act on your mail." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'ha aplicat %1$@: %2$@ està en mode d'avaluació, així que Castellum no fa cap canvi al servidor de correu.\n\nActiva l'escriptura per a aquest compte per actuar sobre el teu correu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ was not applied: %2$@ is in evaluation mode, so Castellum makes no changes to the mail server.\n\nEnable writes for this account to act on your mail."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha aplicado %1$@: %2$@ está en modo de evaluación, así que Castellum no hace ningún cambio en el servidor de correo.\n\nActiva la escritura para esta cuenta para actuar sobre tu correo."
          }
        }
      }
    },
