          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El correo de la bandeja de entrada que cumpla estas condiciones pasa a su propia pestaña. Un mensaje que coincida con varias pestañas va a la primera; el resto se queda en Otros."
          }
