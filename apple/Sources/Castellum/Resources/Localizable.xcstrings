    "%@ goes back to read-only: Castellum will stop making changes to the mail server. Archiving, deleting, flagging and sending will be refused again, and operations still queued for this account will not be sent while it stays read-only." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ torna a només lectura: Castellum deixarà de fer canvis al servidor de correu. Arxivar, eliminar, marcar amb bandera i enviar es tornaran a rebutjar, i les operacions encara en cua per a aquest compte no s'enviaran mentre romangui en només lectura."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ goes back to read-only: Castellum will stop making changes to the mail server. Archiving, deleting, flagging and sending will be refused again, and operations still queued for this account will not be sent while it stays read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuelve a solo lectura: Castellum dejará de hacer cambios en el servidor de correo. Archivar, eliminar, marcar con bandera y enviar se volverán a rechazar, y las operaciones aún en cola para esta cuenta no se enviarán mientras permanezca en solo lectura."
          }
        }
      }
    },
    "%@ is in evaluation mode: Castellum makes no changes to the mail server. Click to enable writes." : {
      "extractionState" : "stale",
      "localizations" : {
        "ca" : {
          "stringUnit" : {
