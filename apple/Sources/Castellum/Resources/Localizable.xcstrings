    "This provider only allows sign-in through its own web login (OAuth), which Castellum doesn’t support yet." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest proveïdor només permet iniciar sessió amb el seu propi accés web (OAuth), que Castellum encara no admet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This provider only allows sign-in through its own web login (OAuth), which Castellum doesn’t support yet."
          }
        },
