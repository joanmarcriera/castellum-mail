    "%lld of %lld accounts read-only (evaluation mode)." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld comptes en només lectura (mode d'avaluació)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld of %2$lld accounts read-only (evaluation mode)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld cuentas en solo lectura (modo de evaluación)."
          }
        }
      }
    },
    "If you enable writes, Castellum retries it straight away." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En activar l'escriptura, Castellum ho torna a provar de seguida."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you enable writes, Castellum retries it straight away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activar la escritura, Castellum lo reintenta de inmediato."
          }
        }
      }
    },
    "Leave evaluation mode for every account that is still read-only. Asks for confirmation first; accounts added later still start read-only." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surt del mode d'avaluació per a tots els comptes que encara són només de lectura. Abans demana confirmació; els comptes afegits més endavant continuen començant en només lectura."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leave evaluation mode for every account that is still read-only. Asks for confirmation first; accounts added later still start read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale del modo de evaluación para todas las cuentas que siguen en solo lectura. Antes pide confirmación; las cuentas añadidas más adelante siguen empezando en solo lectura."
          }
        }
      }
    },
    "Castellum will start making real changes to the mail server for these accounts — archiving, deleting, flagging, marking read and sending will all be applied remotely:\n\n%@\n\nThis covers only the accounts listed. An account you add later still starts read-only." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Castellum començarà a fer canvis reals al servidor de correu per a aquests comptes: arxivar, eliminar, marcar amb bandera, marcar com a llegit i enviar s'aplicaran de manera remota:\n\n%@\n\nAixò només afecta els comptes de la llista. Un compte que afegeixis més endavant començarà en només lectura."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Castellum will start making real changes to the mail server for these accounts — archiving, deleting, flagging, marking read and sending will all be applied remotely:\n\n%@\n\nThis covers only the accounts listed. An account you add later still starts read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Castellum empezará a hacer cambios reales en el servidor de correo para estas cuentas: archivar, eliminar, marcar con bandera, marcar como leído y enviar se aplicarán de forma remota:\n\n%@\n\nEsto solo afecta a las cuentas de la lista. Una cuenta que añadas más adelante empezará en solo lectura."
          }
        }
      }
    },
    "%@ now makes changes to the mail server.\n\n%@ was not applied earlier. Repeat it now." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ara fa canvis al servidor de correu.\n\n%2$@ no s'havia aplicat abans. Cal repetir l'acció ara."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ now makes changes to the mail server.\n\n%2$@ was not applied earlier. Repeat it now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ahora hace cambios en el servidor de correo.\n\n%2$@ no se aplicó antes. Hay que repetir la acción ahora."
          }
        }
      }
    },
