    "How the HTML copy of a Markdown message looks. Each message can override it in its compose window. The plain-text part is always your Markdown source." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com es veu la còpia en HTML d'un missatge en Markdown. Cada missatge ho pot canviar a la seva finestra de redacció. La part de text pla és sempre el teu codi Markdown."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How the HTML copy of a Markdown message looks. Each message can override it in its compose window. The plain-text part is always your Markdown source."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cómo se ve la copia en HTML de un mensaje en Markdown. Cada mensaje puede cambiarlo en su ventana de redacción. La parte de texto sin formato es siempre tu código Markdown."
          }
        }
      }
    },
