    },
    "Used for the HTML part of messages sent with Markdown on; plain-text messages use the Plain Text version. Allowed: links, bold, italic, lists, headings, tables, line breaks. Images, styles and scripts are removed." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'utilitza a la part HTML dels missatges enviats amb Markdown activat; els missatges de text pla fan servir la versió de text pla. Es permeten: enllaços, negreta, cursiva, llistes, encapçalaments, taules i salts de línia. S'eliminen les imatges, els estils i els scripts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used for the HTML part of messages sent with Markdown on; plain-text messages use the Plain Text version. Allowed: links, bold, italic, lists, headings, tables, line breaks. Images, styles and scripts are removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa en la parte HTML de los mensajes enviados con Markdown activado; los mensajes de texto sin formato usan la versión de texto sin formato. Se permiten: enlaces, negrita, cursiva, listas, encabezados, tablas y saltos de línea. Se eliminan las imágenes, los estilos y los scripts."
          }
        }
      }
    },
