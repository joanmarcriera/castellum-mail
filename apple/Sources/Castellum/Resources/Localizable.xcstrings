    },
    "A rule can’t both add and remove the same tag." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regla no pot afegir i eliminar la mateixa etiqueta."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A rule can’t both add and remove the same tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una regla no puede añadir y quitar la misma etiqueta."
          }
        }
      }
    },
    "%@ refused this message — check the recipients, then choose Retry in the Outbox." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rebutjat aquest missatge. Revisa els destinataris i tria Torna-ho a provar a la Safata de sortida."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ refused this message — check the recipients, then choose Retry in the Outbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha rechazado este mensaje. Revisa los destinatarios y elige Reintentar en la Bandeja de salida."
          }
        }
      }
    },
    "The mail server refused the message." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de correu ha rebutjat el missatge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The mail server refused the message."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor de correo ha rechazado el mensaje."
          }
        }
      }
    },
    "Your message was sent. Only its copy in the Sent mailbox is missing; Retry saves it there." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El missatge s’ha enviat. Només en falta la còpia a la bústia d’Enviats; Torna-ho a provar la hi desa."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your message was sent. Only its copy in the Sent mailbox is missing; Retry saves it there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El mensaje se ha enviado. Solo falta su copia en el buzón de Enviados; Reintentar la guarda allí."
          }
        }
      }
    },
    "Microsoft has switched off SMTP sending for this mailbox." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft ha desactivat l’enviament per SMTP en aquesta bústia."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft has switched off SMTP sending for this mailbox."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft ha desactivado el envío por SMTP en este buzón."
          }
        }
      }
    },
    "Signing in again will not help. The setting is called Authenticated SMTP (SMTP AUTH). For a work or school mailbox, ask your administrator to turn on Authenticated SMTP for it in the Microsoft 365 admin centre (Users > Active users > Mail > Manage email apps). A personal Outlook.com mailbox has no such switch, so Castellum cannot send from it yet." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornar a iniciar la sessió no servirà de res. El paràmetre s’anomena SMTP autenticat (SMTP AUTH). En una bústia professional o educativa, demana al teu administrador que hi activi l’SMTP autenticat al Centre d’administració del Microsoft 365 (Usuaris > Usuaris actius > Correu > Administra les aplicacions de correu electrònic). Una bústia personal de l’Outlook.com no té aquest paràmetre, de manera que Castellum encara no hi pot enviar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Signing in again will not help. The setting is called Authenticated SMTP (SMTP AUTH). For a work or school mailbox, ask your administrator to turn on Authenticated SMTP for it in the Microsoft 365 admin centre (Users > Active users > Mail > Manage email apps). A personal Outlook.com mailbox has no such switch, so Castellum cannot send from it yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volver a iniciar sesión no servirá de nada. El ajuste se llama SMTP autenticado (SMTP AUTH). En un buzón profesional o educativo, pide a tu administrador que active SMTP autenticado para él en el Centro de administración de Microsoft 365 (Usuarios > Usuarios activos > Correo > Administrar aplicaciones de correo electrónico). Un buzón personal de Outlook.com no tiene ese ajuste, así que Castellum todavía no puede enviar desde él."
          }
        }
      }
    },
    "Your message stays in the Outbox; choose Retry there once the setting has changed." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teu missatge es queda a la Safata de sortida; tria Torna-ho a provar allà quan el paràmetre hagi canviat."
