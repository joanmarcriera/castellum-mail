          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una sola cuenta en «Aplicar a» para «Mover a…»."
          }
        }
      }
    },
    "Actions that move the message run last, one per match. Each action is queued like a manual one, so it is logged, retried, and held while an account is read-only." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les accions que mouen el missatge s'executen al final, una per coincidència. Cada acció es posa en cua com una de manual, de manera que es registra, es torna a provar i es reté mentre el compte sigui de només lectura."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actions that move the message run last, one per match. Each action is queued like a manual one, so it is logged, retried, and held while an account is read-only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las acciones que mueven el mensaje se ejecutan al final, una por coincidencia. Cada acción se pone en cola como una manual, así que se registra, se reintenta y se retiene mientras la cuenta sea de solo lectura."
          }
        }
      }
    },
