    "Rules run in this order after each sync. A rule marked “stop” takes the messages it matched away from the rules below it." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les regles s'executen en aquest ordre després de cada sincronització. Una regla marcada com a «stop» retira els missatges que coincideixen amb ella de les regles que té a sota."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rules run in this order after each sync. A rule marked “stop” takes the messages it matched away from the rules below it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las reglas se ejecutan en este orden tras cada sincronización. Una regla marcada como «stop» retira los mensajes que coinciden con ella de las reglas que tiene debajo."
          }
        }
      }
    },
    "Read-only accounts (%@): rules cannot change mail there until writes are enabled for the account." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptes de només lectura (%@): les regles no hi poden modificar el correu fins que s'activin les escriptures al compte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only accounts (%@): rules cannot change mail there until writes are enabled for the account."
