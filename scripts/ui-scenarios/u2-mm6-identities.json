{
 "schema": 1,
 "name": "u2-mm6-identities",
 "covers": ["MM-6", "identities, automatic From, Reply-To/Bcc on the wire", "N/A"],
 "requires": {"greenmail": true, "personas": true},
 "screen": {"width": 1280, "height": 768, "menuBar": 25},
 "timeoutMs": 240000,
 "steps": [
  {"op": "wait", "until": "accountsLoaded"},
  {"op": "ext", "id": "setPref", "name": "undoSendDelay", "text": "0"},
  {"op": "addAccount", "persona": "carol", "as": "carol", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "enableWrites", "email": "carol@local.test"},

  {"op": "openWindow", "target": "compose"},
  {"op": "wait", "until": "window:compose"},
  {"op": "wait", "until": "idle"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "to", "text": "shop@local.test, alice@local.test"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "subject", "text": "U2 alias mail {run}"},
  {"op": "ext", "id": "setBody", "window": "compose", "text": "Written to the shop alias first."},
  {"op": "ext", "id": "keyEquivalent", "window": "compose", "text": "cmd+return"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 20000},
  {"op": "ext", "id": "waitExt", "name": "pendingCount", "text": "0", "timeoutMs": 30000},
  {"op": "openWindow", "target": "compose"},
  {"op": "wait", "until": "window:compose"},
  {"op": "wait", "until": "idle"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "to", "text": "alice@local.test"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "cc", "text": "shop@local.test"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "subject", "text": "U2 own mail {run}"},
  {"op": "ext", "id": "setBody", "window": "compose", "text": "Written to alice herself first."},
  {"op": "ext", "id": "keyEquivalent", "window": "compose", "text": "cmd+return"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 20000},
  {"op": "ext", "id": "waitExt", "name": "pendingCount", "text": "0", "timeoutMs": 30000},

  {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "enableWrites", "email": "alice@local.test"},
  {"op": "ext", "id": "createIdentity", "email": "alice@local.test", "text": "shop@local.test", "name": "Alice Shop", "label": "replies@local.test;dave@local.test", "value": true},
  {"op": "ext", "id": "waitExt", "name": "identities:alice@local.test", "text": "shop@local.test*", "timeoutMs": 10000},
  {"op": "wait", "until": "settingsOpenerReady"},
  {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "alice"},
  {"op": "wait", "until": "window:settings"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "identities-list", "windows": ["settings"]},
  {"op": "closeWindow", "window": "settings"},

  {"op": "ext", "id": "selectMailbox", "email": "alice@local.test", "text": "inbox"},
  {"op": "ext", "id": "selectMessage", "text": "=U2 own mail {run}", "timeoutMs": 40000},
  {"op": "wait", "until": "idle"},
  {"op": "openWindow", "target": "compose"},
  {"op": "wait", "until": "window:compose"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "new-message-from-default-alias", "windows": ["compose"]},
  {"op": "assert", "expect": [{"model": "ext:sendAs", "equals": "Alice Shop <shop@local.test>"}]},
  {"op": "ext", "id": "closeCompose"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 10000},

  {"op": "ext", "id": "selectMessage", "text": "=U2 alias mail {run}", "timeoutMs": 20000},
  {"op": "wait", "until": "idle"},
  {"op": "command", "id": "reply"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "1", "timeoutMs": 10000},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "reply-to-alias-mail"},
  {"op": "assert", "expect": [{"model": "ext:sendAs", "equals": "Alice Shop <shop@local.test>"}]},
  {"op": "ext", "id": "setPopup", "window": "@compose", "find": {"role": "popup", "label": "Alice Shop <shop@local.test>"}, "text": "alice@local.test"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "from-picked-by-hand"},
  {"op": "assert", "expect": [{"model": "ext:sendAs", "equals": "alice@local.test"}]},
  {"op": "ext", "id": "closeCompose"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 10000},

  {"op": "ext", "id": "selectMessage", "text": "=U2 own mail {run}", "timeoutMs": 20000},
  {"op": "wait", "until": "idle"},
  {"op": "command", "id": "reply"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "1", "timeoutMs": 10000},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "reply-to-own-address-mail"},
  {"op": "assert", "expect": [{"model": "ext:sendAs", "equals": "alice@local.test"}]},
  {"op": "ext", "id": "closeCompose"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 10000},

  {"op": "openWindow", "target": "compose"},
  {"op": "wait", "until": "window:compose"},
  {"op": "wait", "until": "idle"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "to", "text": "bob@local.test"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "subject", "text": "U2 wire {run}"},
  {"op": "ext", "id": "setBody", "window": "compose", "text": "Sent from the alias with Reply-To and Bcc."},
  {"op": "ext", "id": "keyEquivalent", "window": "compose", "text": "cmd+return"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 20000},
  {"op": "ext", "id": "waitExt", "name": "pendingCount", "text": "0", "timeoutMs": 30000},

  {"op": "addAccount", "persona": "bob", "as": "bob", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "selectMailbox", "email": "bob@local.test", "text": "inbox"},
  {"op": "ext", "id": "selectMessage", "text": "=U2 wire {run}", "timeoutMs": 90000},
  {"op": "ext", "id": "loadSource", "timeoutMs": 30000},
  {"op": "assert", "expect": [
    {"model": "ext:src.has:From: ", "equals": "true"},
    {"model": "ext:src.has:shop@local.test", "equals": "true"},
    {"model": "ext:src.has:Reply-To: replies@local.test", "equals": "true"},
    {"model": "ext:src.has:dave@local.test", "equals": "false"}
  ]},
  {"op": "addAccount", "persona": "dave", "as": "dave", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "selectMailbox", "email": "dave@local.test", "text": "inbox"},
  {"op": "ext", "id": "waitExt", "name": "messageCount:U2 wire {run}", "text": "1", "timeoutMs": 40000},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "bcc-recipient-inbox", "windows": ["main"]},
  {"op": "quit"}
 ]
}
