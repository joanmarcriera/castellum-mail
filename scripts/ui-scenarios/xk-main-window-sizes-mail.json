{
 "schema": 1,
 "name": "xk-main-window-sizes-mail",
 "covers": [
  "main window min and large, both layouts, message open"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "Invoice R0012345678"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "layoutWidescreen"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "mail-layoutWidescreen-min",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "label": "mail layoutWidescreen at min",
   "expect": [
    {
     "model": "reading:tableFound",
     "equals": "true"
    },
    {
     "model": "reading:selectedSubject",
     "equals": "Invoice R0012345678 for August 2026"
    }
   ],
   "window": "main",
   "rules": [
    "nonBlank"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1900,
    1000
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "mail-layoutWidescreen-large",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "label": "mail layoutWidescreen large",
   "expect": [
    {
     "model": "reading:tableFound",
     "equals": "true"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "window": "main",
   "rules": [
    "nonBlank",
    "onScreen"
   ]
  },
  {
   "op": "command",
   "id": "layoutClassic"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "mail-layoutClassic-min",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "label": "mail layoutClassic at min",
   "expect": [
    {
     "model": "reading:tableFound",
     "equals": "true"
    },
    {
     "model": "reading:selectedSubject",
     "equals": "Invoice R0012345678 for August 2026"
    }
   ],
   "window": "main",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1900,
    1000
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "mail-layoutClassic-large",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "label": "mail layoutClassic large",
   "expect": [
    {
     "model": "reading:tableFound",
     "equals": "true"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "window": "main",
   "rules": [
    "nonBlank",
    "onScreen"
   ]
  },
  {
   "op": "quit"
  }
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 }
}