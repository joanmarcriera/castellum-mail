{ "schema": 1, "name": "u5-s20-duplicate-save",
  "covers": ["S20", "N/A", "Accounts: Duplicate... saved as a second account; source untouched"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "alice"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Duplicate…"}, "name": "sheet:duplicate"},
    {"op": "wait", "until": "sheet:duplicate"},
    {"op": "wait", "until": "idle"},
    {"op": "setText", "window": "sheet:duplicate", "find": {"identifier": "email"}, "text": "bob@local.test"},
    {"op": "setText", "window": "sheet:duplicate", "find": {"identifier": "username"}, "text": "bob@local.test"},
    {"op": "setText", "window": "sheet:duplicate", "find": {"identifier": "password"}, "text": "bob-pass"},
    {"op": "setText", "window": "sheet:duplicate", "find": {"identifier": "smtpUsername"}, "text": "bob@local.test"},
    {"op": "setText", "window": "sheet:duplicate", "find": {"identifier": "smtpPassword"}, "text": "bob-pass"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "duplicate-filled-for-bob"},
    {"op": "assert", "window": "sheet:duplicate", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible"],
     "expect": [
       {"find": {"identifier": "sync"}, "enabled": true},
       {"model": "accounts:field:sheet:duplicate|#2", "equals": "127.0.0.1"},
       {"model": "accounts:field:sheet:duplicate|#3", "equals": "3143"} ]},
    {"op": "press", "window": "sheet:duplicate", "find": {"identifier": "sync"}},
    {"op": "wait", "until": "sync:bob@local.test=ok", "timeoutMs": 90000},
    {"op": "accounts", "id": "settle", "text": "1500"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "after-duplicate-saved"},
    {"op": "assert", "expect": [
       {"model": "accountCount", "equals": "2"},
       {"model": "accounts:endpoint:alice", "equals": "127.0.0.1:3143"},
       {"model": "accounts:endpoint:bob@local.test", "equals": "127.0.0.1:3143"},
       {"model": "accounts:dotState:alice", "equals": "ok"},
       {"model": "accounts:dotState:bob@local.test", "equals": "ok"} ]},
    {"op": "quit"} ] }
