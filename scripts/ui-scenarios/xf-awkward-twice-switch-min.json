{
 "schema": 1,
 "name": "xf-awkward-twice-switch-min",
 "covers": [
  "archive",
  "delete",
  "twice",
  "min-window",
  "long-subject",
  "switch-mid-action"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xf-h@local.test",
   "password": "xf-h@local.test",
   "as": "h",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xf-h@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "h",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "6"
    }
   ],
   "label": "6 seeded"
  },
  {
   "op": "reading",
   "id": "clearMessage"
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "reading",
   "id": "deleteSelected"
  },
  {
   "op": "command",
   "id": "toggleFlag",
   "allowServerWrites": true
  },
  {
   "op": "command",
   "id": "toggleRead",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "600"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "6"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "label": "nothing selected: nothing happens"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF h msg 5"
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "600"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "5"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "label": "Archive three times fast archives one message"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF h msg 4"
  },
  {
   "op": "reading",
   "id": "deleteSelected"
  },
  {
   "op": "reading",
   "id": "selectUnified",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "h",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "600"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "4"
    },
    {
     "model": "reading:hasSubject:XF h msg 4",
     "equals": "false"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "label": "switching lists mid-delete does not resurrect the row"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF h long"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "min-window-long-subject"
  },
  {
   "op": "assert",
   "window": "main",
   "rules": [
    "nonBlank"
   ],
   "label": "smallest window still draws"
  },
  {
   "op": "command",
   "id": "toggleFlag",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "300"
  },
  {
   "op": "command",
   "id": "toggleFlag",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "300"
  },
  {
   "op": "reading",
   "id": "deleteSelected"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "600"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "3"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "label": "long-subject mail deleted at the smallest window"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "3"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ],
   "label": "stable after replay"
  },
  {
   "op": "capture",
   "name": "end"
  },
  {
   "op": "reading",
   "id": "selectUnified",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF h msg 3"
  },
  {
   "op": "reading",
   "id": "deleteSelected"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "h",
   "text": "trash"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "hasSubject:XF h msg 3",
   "text": "true",
   "timeoutMs": 20000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "3"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "label": "Trash after the journey"
  },
  {
   "op": "quit"
  }
 ]
}