{ "schema": 1, "name": "xg-ai-tab-enabled-min",
  "covers": ["Settings > AI with AI enabled, at the minimum window size and at 900x700: every section (Connection, Activity, Help) must be reachable"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25}, "timeoutMs": 60000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "ext", "id": "setPref", "name": "aiEnabled", "text": "true"},
    {"op": "ext", "id": "setPref", "name": "aiEndpoint", "text": "http://127.0.0.1:11434"},
    {"op": "wait", "until": "settingsOpenerReady", "timeoutMs": 15000},
    {"op": "openWindow", "target": "settings", "tab": "ai"},
    {"op": "wait", "until": "window:settings"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-ai-enabled-default", "windows": ["settings"]},
    {"op": "resizeWindow", "window": "settings", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-ai-enabled-min", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText", "controlsReachable", "noZeroSizeTextFields"]},
    {"op": "resizeWindow", "window": "settings", "contentSize": [900, 700]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-ai-enabled-large", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText", "controlsReachable"]},
    {"op": "quit"} ] }
