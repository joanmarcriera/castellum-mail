{ "schema": 1, "name": "u1-gui4-signatures-window",
  "covers": ["GUI-4", "N/A", "PR-190", "S71", "N/A", "Signatures window: separate, movable, resizable, several per account, default badge moves"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "addAccount", "persona": "bob", "as": "bob", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "bob"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "openWindow", "target": "signatures", "accountRef": "bob"},
    {"op": "wait", "until": "window:signatures"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-signatures-window-empty"},
    {"op": "assert", "window": "signatures", "rules": ["nonBlank", "resizable", "movable", "fitsScreen", "noClippedText"],
     "expect": [ {"model": "accounts:autosaveName:signatures", "equals": "CastellumSignaturesWindow"},
                 {"model": "accounts:signatures:bob", "equals": ""} ]},
    {"op": "accounts", "id": "sigAdd", "accountRef": "bob", "text": "Work"},
    {"op": "accounts", "id": "sigAdd", "accountRef": "bob", "text": "Personal"},
    {"op": "accounts", "id": "sigAdd", "accountRef": "alice", "text": "Signature"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-two-signatures-first-is-default"},
    {"op": "assert", "window": "signatures", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "accounts:signatures:bob", "equals": "Work*,Personal"},
                 {"model": "accounts:signatures:alice", "equals": "Signature*"} ]},
    {"op": "accounts", "id": "sigRename", "text": "Personal", "name": "Home"},
    {"op": "accounts", "id": "sigDefault", "text": "Home"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-renamed-and-default-moved"},
    {"op": "assert", "window": "signatures", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "accounts:signatures:bob", "equals": "Work,Home*"} ]},
    {"op": "accounts", "id": "sigDelete", "text": "Home"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "04-default-deleted-other-takes-over"},
    {"op": "assert", "window": "signatures", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "accounts:signatures:bob", "equals": "Work*"} ]},
    {"op": "resizeWindow", "window": "signatures", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "05-signatures-window-min-size"},
    {"op": "assert", "window": "signatures", "rules": ["nonBlank", "fitsScreen", "noClippedText", "controlsReachable"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText"],
     "expect": [ {"model": "accountCount", "equals": "2"} ]},
    {"op": "quit"} ] }
