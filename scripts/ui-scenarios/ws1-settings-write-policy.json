{
 "schema": 1,
 "name": "ws1-settings-write-policy",
 "covers": ["WS1", "Settings > Accounts: per-account write control and the confirmed all-accounts action", "N/A"],
 "requires": {"greenmail": true, "personas": true},
 "screen": {"width": 1280, "height": 768, "menuBar": 25},
 "timeoutMs": 180000,
 "steps": [
  {"op": "wait", "until": "accountsLoaded"},
  {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "addAccount", "persona": "bob", "as": "bob", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "addAccount", "persona": "carol", "as": "carol", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "waitExt", "name": "readOnlyAccounts", "text": "alice@local.test|bob@local.test|carol@local.test", "timeoutMs": 15000},

  {"op": "wait", "until": "settingsOpenerReady"},
  {"op": "openWindow", "target": "settings", "tab": "accounts"},
  {"op": "wait", "until": "window:settings"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "settings-accounts-read-only", "windows": ["settings"]},

  {"op": "press", "window": "settings", "find": {"identifier": "writePolicy:alice@local.test"}},
  {"op": "wait", "until": "window:sheetOf:settings", "timeoutMs": 15000},
  {"op": "ext", "id": "pause", "text": "600"},
  {"op": "capture", "name": "per-account-confirmation", "windows": ["settings", "sheetOf:settings"]},
  {"op": "assert", "expect": [
    {"model": "ext:writePrompt", "equals": "enable-alice@local.test"},
    {"model": "ext:sheetButtons", "equals": "Cancel|Enable Writes"},
    {"model": "ext:readOnlyAccounts", "equals": "alice@local.test|bob@local.test|carol@local.test"}
  ]},
  {"op": "press", "window": "sheetOf:settings", "find": {"role": "button", "label": "Enable Writes"}},
  {"op": "ext", "id": "waitExt", "name": "readOnlyAccounts", "text": "bob@local.test|carol@local.test", "timeoutMs": 15000},
  {"op": "ext", "id": "waitExt", "name": "sheetHosts", "text": "none", "timeoutMs": 15000},

  {"op": "press", "window": "settings", "find": {"identifier": "enableWritesForAll"}},
  {"op": "wait", "until": "window:sheetOf:settings", "timeoutMs": 15000},
  {"op": "ext", "id": "pause", "text": "600"},
  {"op": "capture", "name": "all-accounts-confirmation", "windows": ["settings", "sheetOf:settings"]},
  {"op": "assert", "expect": [
    {"model": "ext:writePrompt", "equals": "enable-all-bob@local.test,carol@local.test"},
    {"model": "ext:sheetButtons", "equals": "Cancel|Enable Writes for All"},
    {"model": "ext:readOnlyAccounts", "equals": "bob@local.test|carol@local.test"}
  ]},
  {"op": "press", "window": "sheetOf:settings", "find": {"role": "button", "label": "Cancel"}},
  {"op": "ext", "id": "waitExt", "name": "sheetHosts", "text": "none", "timeoutMs": 15000},
  {"op": "assert", "expect": [
    {"model": "ext:writePrompt", "equals": "none"},
    {"model": "ext:readOnlyAccounts", "equals": "bob@local.test|carol@local.test"}
  ]},

  {"op": "press", "window": "settings", "find": {"identifier": "enableWritesForAll"}},
  {"op": "wait", "until": "window:sheetOf:settings", "timeoutMs": 15000},
  {"op": "press", "window": "sheetOf:settings", "find": {"role": "button", "label": "Enable Writes for All"}},
  {"op": "ext", "id": "waitExt", "name": "readOnlyAccounts", "text": "none", "timeoutMs": 15000},
  {"op": "ext", "id": "waitExt", "name": "sheetHosts", "text": "none", "timeoutMs": 15000},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "settings-accounts-writes-enabled", "windows": ["settings"]}
 ]
}
