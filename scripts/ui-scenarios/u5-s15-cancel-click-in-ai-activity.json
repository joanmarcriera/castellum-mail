{ "schema": 1, "name": "u5-s15-cancel-click-in-ai-activity",
  "covers": ["S15", "N/A", "A real click on Cancel in a running AI Activity row flips it to Cancelled and the job stops"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "ext", "id": "aiProbeFirstLaunch", "timeoutMs": 15000},
    {"op": "ext", "id": "waitExt", "name": "pref.aiEnabled", "text": "true", "timeoutMs": 15000},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 60000},
    {"op": "ext", "id": "aiUseFirstModel", "text": "llama3.1:8b|qwen2.5:7b|largest"},
    {"op": "ext", "id": "selectMailbox", "email": "alice@local.test", "text": "inbox"},
    {"op": "ext", "id": "selectMessage", "text": "This Week in Rust", "timeoutMs": 30000},
    {"op": "wait", "until": "idle"},
    {"op": "command", "id": "summarize"},
    {"op": "ext", "id": "waitAiJob", "name": "summarize_message", "text": "running", "timeoutMs": 20000},
    {"op": "openWindow", "target": "aiActivity"},
    {"op": "wait", "until": "window:aiActivity"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-running-row-with-cancel", "windows": ["aiActivity"]},
    {"op": "assert", "expect": [{"model": "ext:aiJob.summarize_message", "equals": "running"}]},
    {"op": "accounts", "id": "click", "window": "aiActivity", "text": "522,24"},
    {"op": "ext", "id": "waitExt", "name": "aiJob.summarize_message", "text": "cancelled", "timeoutMs": 10000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-after-click-cancelled", "windows": ["aiActivity"]},
    {"op": "assert", "expect": [{"model": "ext:aiJob.summarize_message", "equals": "cancelled"}, {"model": "ext:aiJobsRunning", "equals": "0"}]},
    {"op": "quit"} ] }
