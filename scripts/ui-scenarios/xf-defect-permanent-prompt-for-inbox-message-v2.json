{
 "schema": 1,
 "name": "xf-defect-permanent-prompt-for-inbox-message-v2",
 "covers": [
  "delete",
  "trash",
  "search",
  "permanent-delete"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xf-i@local.test",
   "password": "xf-i@local.test",
   "as": "i",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xf-i@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "i",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XF i msg 5",
     "equals": "true"
    }
   ],
   "label": "precondition: 'XF i msg 5' is in the Inbox (re-seed xf-i@local.test by SMTP if a fixed build moved it to Trash)"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "i",
   "text": "trash"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "800"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "account"
  },
  {
   "op": "search",
   "text": "XF i msg 5"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "900"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XF i msg 5",
     "equals": "true"
    },
    {
     "model": "reading:mailboxRole",
     "equals": "trash"
    }
   ],
   "label": "Trash selected, account-scope search lists the Inbox message"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF i msg 5"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "deleteSelected"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1000"
  },
  {
   "op": "capture",
   "name": "prompt-for-inbox-message",
   "windows": [
    "all"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:pendingDelete",
     "equals": "false"
    }
   ],
   "label": "Delete on an Inbox row found by search must move it to Trash, not ask to delete permanently"
  },
  {
   "op": "reading",
   "id": "cancelDelete"
  },
  {
   "op": "quit"
  }
 ]
}