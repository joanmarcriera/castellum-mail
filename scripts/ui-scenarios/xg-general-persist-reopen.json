{ "schema": 1, "name": "xg-general-persist-reopen",
  "covers": ["Settings > General: popup values chosen (HTML theme, Undo send, attachment click, update schedule) survive closing and reopening Settings, twice"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25}, "timeoutMs": 90000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "wait", "until": "settingsOpenerReady", "timeoutMs": 15000},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [700, 680]},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "Plain (no styling)"}, "text": "Serif"},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "10 seconds"}, "text": "30 seconds"},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "Ask each time"}, "text": "Quick Look"},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "Daily"}, "text": "Never"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-changed", "windows": ["settings"]},
    {"op": "assert", "expect": [{"model": "ext:pref.undoSendDelay", "equals": "30"}, {"model": "ext:pref.markdownTheme", "equals": "serif"}]},
    {"op": "closeWindow", "window": "settings"},
    {"op": "accounts", "id": "settle", "text": "400"},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-reopened", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText"], "expect": [
      {"find": {"role": "popup", "label": "Serif"}, "exists": true, "visible": true},
      {"find": {"role": "popup", "label": "30 seconds"}, "exists": true},
      {"find": {"role": "popup", "label": "Quick Look"}, "exists": true},
      {"find": {"role": "popup", "label": "Never"}, "exists": true},
      {"find": {"role": "popup", "label": "Daily"}, "exists": false}]},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "30 seconds"}, "text": "Off"},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "Quick Look"}, "text": "Ask each time"},
    {"op": "closeWindow", "window": "settings"},
    {"op": "accounts", "id": "settle", "text": "400"},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-reopened-again", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank"], "expect": [
      {"find": {"role": "popup", "label": "Off"}, "exists": true},
      {"find": {"role": "popup", "label": "Ask each time"}, "exists": true},
      {"model": "ext:pref.undoSendDelay", "equals": "0"}]},
    {"op": "quit"} ] }
