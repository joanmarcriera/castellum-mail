{ "schema": 1, "name": "xh-walk-banner-actions",
  "covers": ["offline walk: banner Retry click, dismiss, wrong password on a long address, smallest window"],
  "requires": {"greenmail": true}, "screen": {"width": 1440, "height": 900, "menuBar": 25},
  "timeoutMs": 240000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "email": "xh-one@local.test", "password": "xh-one@local.test", "as": "one", "waitFor": "synced", "timeoutMs": 60000},
    {"op": "addAccount", "email": "xh-very-long-local-part-for-banner-wrapping-checks-0123456789@local.test", "password": "xh-very-long-local-part-for-banner-wrapping-checks-0123456789@local.test", "as": "long", "waitFor": "synced", "timeoutMs": 60000},
    {"op": "resizeWindow", "window": "main", "contentSize": [1300, 600]},
    {"op": "reading", "id": "selectMailbox", "accountRef": "one", "text": "inbox"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "setEndpoint", "accountRef": "one", "text": "127.0.0.1:3999"},
    {"op": "wait", "until": "sync:one=failed", "timeoutMs": 60000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-one-down", "windows": ["main"]},
    {"op": "accounts", "id": "setEndpoint", "accountRef": "one", "text": "127.0.0.1:3143", "value": false},
    {"op": "accounts", "id": "click", "window": "main", "text": "1148,67"},
    {"op": "wait", "until": "sync:one=ok", "timeoutMs": 30000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-recovered-by-banner-retry", "windows": ["main"]},
    {"op": "assert", "expect": [ {"model": "reading:syncBanner", "equals": "none"}, {"model": "errorText", "equals": ""} ]},
    {"op": "reading", "id": "breakPassword", "accountRef": "long"},
    {"op": "wait", "until": "sync:long=failed", "timeoutMs": 60000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-long-wrong-password", "windows": ["main"]},
    {"op": "assert", "window": "main", "rules": ["nonBlank"], "expect": [
       {"model": "reading:bannerOverlapsHeader", "equals": "false"},
       {"model": "reading:bannerWithinWindow", "equals": "true"},
       {"model": "errorText", "equals": ""}, {"sheetAttached": false} ]},
    {"op": "resizeWindow", "window": "main", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "04-long-wrong-password-min-window", "windows": ["main"]},
    {"op": "assert", "expect": [
       {"model": "reading:bannerOverlapsHeader", "equals": "false"},
       {"model": "reading:bannerWithinWindow", "equals": "true"} ]},
    {"op": "command", "id": "layoutClassic"},
    {"op": "wait", "until": "idle"},
    {"op": "resizeWindow", "window": "main", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "05-classic-min", "windows": ["main"]},
    {"op": "assert", "expect": [
       {"model": "reading:bannerOverlapsHeader", "equals": "false"},
       {"model": "reading:bannerWithinWindow", "equals": "true"} ]},
    {"op": "command", "id": "layoutWidescreen"},
    {"op": "resizeWindow", "window": "main", "contentSize": [1300, 600]},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "click", "window": "main", "text": "1280,67"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "06-dismissed", "windows": ["main"]},
    {"op": "assert", "expect": [ {"model": "reading:syncBanner", "equals": "none"}, {"model": "accounts:dotState:long", "equals": "authenticationFailed"} ]},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "long"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "07-settings-accounts-long-failed", "windows": ["settings"]},
    {"op": "openWindow", "target": "status"},
    {"op": "wait", "until": "window:status"},
    {"op": "resizeWindow", "window": "status", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "08-status-min", "windows": ["status"]},
    {"op": "assert", "window": "status", "rules": ["nonBlank", "fitsScreen", "noClippedText"]},
    {"op": "quit"} ] }
