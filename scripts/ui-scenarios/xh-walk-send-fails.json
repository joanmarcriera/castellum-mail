{ "schema": 1, "name": "xh-walk-send-fails",
  "covers": ["offline walk: SMTP on a closed port; send with writes enabled; what the user is told and where the message is kept"],
  "requires": {"greenmail": true}, "screen": {"width": 1440, "height": 900, "menuBar": 25},
  "timeoutMs": 240000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "email": "xh-one@local.test", "password": "xh-one@local.test", "smtp": "127.0.0.1:3998", "as": "one", "waitFor": "synced", "timeoutMs": 60000},
    {"op": "resizeWindow", "window": "main", "contentSize": [1300, 600]},
    {"op": "ext", "id": "enableWrites", "email": "xh-one@local.test"},
    {"op": "ext", "id": "setPref", "name": "undoSendDelay", "text": "5"},
    {"op": "openWindow", "target": "compose"},
    {"op": "wait", "until": "window:compose"},
    {"op": "wait", "until": "idle"},
    {"op": "ext", "id": "setField", "window": "compose", "name": "to", "text": "xh-two@local.test"},
    {"op": "ext", "id": "setField", "window": "compose", "name": "subject", "text": "XH unsendable {run}"},
    {"op": "ext", "id": "setBody", "window": "compose", "text": "This cannot leave: SMTP is on a closed port."},
    {"op": "wait", "until": "idle"},
    {"op": "ext", "id": "keyEquivalent", "window": "compose", "text": "cmd+return"},
    {"op": "ext", "id": "waitExt", "name": "undoBanner", "text": "shown", "timeoutMs": 15000},
    {"op": "capture", "name": "01-undo-countdown"},
    {"op": "ext", "id": "waitExt", "name": "undoBanner", "text": "hidden", "timeoutMs": 20000},
    {"op": "accounts", "id": "settle", "text": "6000"},
    {"op": "capture", "name": "02-after-send-attempt"},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "outbox"},
    {"op": "wait", "until": "window:outbox"},
    {"op": "openWindow", "target": "status"},
    {"op": "wait", "until": "window:status"},
    {"op": "resizeWindow", "window": "status", "contentSize": [620, 460]},
    {"op": "accounts", "id": "settle", "text": "1500"},
    {"op": "capture", "name": "03-outbox-and-status"},
    {"op": "assert", "expect": [ {"model": "ext:pendingCount", "equals": "1"}, {"model": "errorText", "equals": ""} ]},
    {"op": "quit"} ] }
