{ "schema": 1, "name": "u1-s71-gui3-settings-layout",
  "covers": ["S71", "PR-190", "N/A", "N/A", "GUI-3", "N/A", "Settings: shrink, move, resize, frame saved; Add and Re-authenticate sheets stay on screen"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-general-at-min-size"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "resizable", "movable", "fitsScreen", "noClippedText", "controlsReachable"],
     "expect": [ {"model": "accounts:autosaveName:settings", "equals": "CastellumSettingsWindow"} ]},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "accounts", "id": "moveWindow", "window": "settings", "text": "140,120"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-moved-and-resized"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen"],
     "expect": [ {"model": "accounts:defaults:NSWindow Frame CastellumSettingsWindow", "equals": "set"},
                 {"model": "accounts:frame:settings", "equals": "140,120,760,560"} ]},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "alice"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-accounts-tab-same-window"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText"]},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Add…"}, "name": "sheet:add"},
    {"op": "wait", "until": "sheet:add"},
    {"op": "wait", "until": "idle"},
    {"op": "resizeWindow", "window": "sheet:add", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "04-add-sheet-min-height"},
    {"op": "assert", "window": "sheet:add", "rules": ["nonBlank", "movableSheet", "fitsScreen", "onScreen", "primaryButtonsVisible", "controlsReachable"]},
    {"op": "press", "window": "sheet:add", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:add"},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Re-authenticate…"}, "name": "sheet:reauth"},
    {"op": "wait", "until": "sheet:reauth"},
    {"op": "wait", "until": "idle"},
    {"op": "resizeWindow", "window": "sheet:reauth", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "05-reauth-sheet-min-height"},
    {"op": "assert", "window": "sheet:reauth", "rules": ["nonBlank", "movableSheet", "fitsScreen", "onScreen", "primaryButtonsVisible", "controlsReachable"]},
    {"op": "press", "window": "sheet:reauth", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:reauth"},
    {"op": "quit"} ] }
