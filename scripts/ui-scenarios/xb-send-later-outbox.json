{
 "schema": 1,
 "name": "xb-send-later-outbox",
 "covers": [
  "send later",
  "a scheduled send is listed in the Outbox with its time and actions, and is not delivered"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "reading",
   "id": "scheduleSend",
   "accountRef": "alice",
   "text": "xb scheduled {run}"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "1"
    }
   ]
  },
  {
   "op": "openWindow",
   "target": "outbox"
  },
  {
   "op": "wait",
   "until": "window:title:Outbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "outbox-scheduled"
  },
  {
   "op": "assert",
   "window": "outbox",
   "rules": [
    "nonBlank",
    "onScreen",
    "noClippedText"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}