{
 "schema": 1,
 "name": "u4-reader-body-plain-links",
 "covers": [
  "UIT-1 reader-pane body capture",
  "links in a plain-text body are shown in the body"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "bob",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "[castellum] Run failed: rust-ci (main)"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "reader-body",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:detailTextHas:https://example.org/actions/runs/3861",
     "equals": "true"
    },
    {
     "model": "reading:detailTextHas:Error: unused variable",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
