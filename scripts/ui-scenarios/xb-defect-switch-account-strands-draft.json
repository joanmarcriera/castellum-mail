{
 "schema": 1,
 "name": "xb-defect-switch-account-strands-draft",
 "covers": [
  "compose",
  "typed as the first account, From switched to the second, sent: nothing may stay queued and the first account must not keep a draft of a message that was sent"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "alice@local.test",
   "text": "inbox"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "carol@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb switch {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Typed as Alice, sent as Bob."
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "4000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "typed-as-alice"
  },
  {
   "op": "ext",
   "id": "setPopup",
   "window": "@compose",
   "find": {
    "role": "popup",
    "label": "alice@local.test"
   },
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "4000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "switched-to-bob"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "8000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openWindow",
   "target": "outbox"
  },
  {
   "op": "wait",
   "until": "window:title:Outbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "outbox-after-send"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "assert",
   "window": "main",
   "expect": [
    {
     "find": {
      "text": "Local Drafts"
     },
     "exists": false
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}