{
 "schema": 1,
 "name": "xk-defect-empty-trash-without-trash",
 "covers": [
  "Empty Trash",
  "command predicates"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 60000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "no account, so no Trash anywhere",
   "expect": [
    {
     "windowCount": 1
    },
    {
     "model": "accountCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "class:SheetPresentationWindow",
   "text": "empty trash"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "class:SheetPresentationWindow",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "empty-trash-with-no-account"
  },
  {
   "op": "accounts",
   "id": "waitNode",
   "window": "class:_NSAlertPanel",
   "find": {
    "text": "There is no Trash to empty. Select a mailbox first."
   },
   "value": true,
   "timeoutMs": 3000,
   "label": "the alert explains there is no Trash to empty"
  },
  {
   "op": "accounts",
   "id": "waitNode",
   "window": "class:_NSAlertPanel",
   "find": {
    "text": "Empty Trash"
   },
   "value": false,
   "timeoutMs": 3000,
   "label": "no permanent-erase confirmation (no Empty Trash button)"
  },
  {
   "op": "quit"
  }
 ]
}