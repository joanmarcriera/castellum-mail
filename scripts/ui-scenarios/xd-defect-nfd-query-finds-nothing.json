{
 "schema": 1,
 "name": "xd-defect-nfd-query-finds-nothing",
 "covers": [
  "search",
  "accents ca/es",
  "Unicode normalisation"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "mailbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "càlcul"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:searchText",
     "equals": "càlcul"
    }
   ]
  },
  {
   "op": "search",
   "text": "càlcul"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:searchText",
     "equals": "càlcul"
    }
   ]
  },
  {
   "op": "search",
   "text": "año"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:searchText",
     "equals": "año"
    }
   ]
  },
  {
   "op": "capture",
   "name": "nfd-query"
  },
  {
   "op": "quit"
  }
 ]
}