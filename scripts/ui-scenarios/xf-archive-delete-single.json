{
 "schema": 1,
 "name": "xf-archive-delete-single",
 "covers": [
  "archive",
  "delete",
  "read",
  "flag",
  "counts"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xf-c@local.test",
   "password": "xf-c@local.test",
   "as": "c",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xf-c@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "c",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "5"
    }
   ],
   "label": "5 seeded"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF c msg 3"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "toggleFlag",
   "allowServerWrites": true
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "capture",
   "name": "flagged"
  },
  {
   "op": "search",
   "text": "is:flagged"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:hasSubject:XF c msg 3",
     "equals": "true"
    }
   ],
   "label": "flag shows in is:flagged"
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF c msg 3"
  },
  {
   "op": "command",
   "id": "toggleFlag",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "search",
   "text": "is:flagged"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "0"
    }
   ],
   "label": "unflag"
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF c msg 3"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "4"
    },
    {
     "model": "reading:hasSubject:XF c msg 3",
     "equals": "false"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ],
   "label": "archived row leaves at once"
  },
  {
   "op": "capture",
   "name": "after-archive"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "4"
    },
    {
     "model": "reading:hasSubject:XF c msg 3",
     "equals": "false"
    }
   ],
   "label": "still gone after replay + re-sync"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF c msg 1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "reading",
   "id": "deleteSelected"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "3"
    },
    {
     "model": "reading:hasSubject:XF c msg 1",
     "equals": "false"
    }
   ],
   "label": "deleted row leaves"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "3"
    }
   ],
   "label": "still gone"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF c msg 5"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "toggleRead",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedUnread",
     "equals": "true"
    }
   ],
   "label": "marked unread"
  },
  {
   "op": "command",
   "id": "toggleRead",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedUnread",
     "equals": "false"
    }
   ],
   "label": "and read again"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "c",
   "text": "trash"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "hasSubject:XF c msg 1",
   "text": "true",
   "timeoutMs": 20000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    }
   ],
   "label": "Trash holds exactly the deleted one"
  },
  {
   "op": "capture",
   "name": "trash"
  },
  {
   "op": "search",
   "text": "is:unread"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XF c msg 1",
     "equals": "false"
    }
   ],
   "label": "it was read before the delete (and the read had synced): still read in Trash"
  },
  {
   "op": "quit"
  }
 ]
}