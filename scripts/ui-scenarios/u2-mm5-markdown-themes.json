{
 "schema": 1,
 "name": "u2-mm5-markdown-themes",
 "covers": ["MM-5", "Markdown themes", "N/A"],
 "requires": {"greenmail": true, "personas": true},
 "screen": {"width": 1280, "height": 768, "menuBar": 25},
 "timeoutMs": 170000,
 "steps": [
  {"op": "wait", "until": "accountsLoaded"},
  {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "enableWrites", "email": "alice@local.test"},
  {"op": "ext", "id": "setPref", "name": "undoSendDelay", "text": "0"},
  {"op": "wait", "until": "settingsOpenerReady"},
  {"op": "openWindow", "target": "settings", "tab": "general"},
  {"op": "wait", "until": "window:settings"},
  {"op": "wait", "until": "idle"},
  {"op": "ext", "id": "expectPopupItems", "window": "settings", "find": {"role": "popup", "label": "Plain (no styling)"}, "text": "Plain (no styling)|Clean|Serif|Compact"},
  {"op": "capture", "name": "settings-html-theme", "windows": ["settings"]},
  {"op": "assert", "expect": [{"model": "ext:pref.markdownTheme", "equals": "plain"}]},
  {"op": "closeWindow", "window": "settings"},

  {"op": "openWindow", "target": "compose"},
  {"op": "wait", "until": "window:compose"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "markdown-off", "windows": ["compose"]},
  {"op": "ext", "id": "composeSet", "window": "compose", "name": "markdown", "value": true},
  {"op": "wait", "until": "idle"},
  {"op": "ext", "id": "expectPopupItems", "window": "compose", "find": {"role": "popup", "label": "Plain (no styling)"}, "text": "Plain (no styling)|Clean|Serif|Compact"},
  {"op": "ext", "id": "setBody", "window": "compose", "text": "# Heading\n\n- one\n- two\n\n> a quote\n\n```\ncode block\n```\n\n| a | b |\n|---|---|\n| 1 | 2 |\n"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "markdown-plain-theme", "windows": ["compose"]},
  {"op": "ext", "id": "setPopup", "window": "compose", "find": {"role": "popup", "label": "Plain (no styling)"}, "text": "Serif"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "markdown-serif-theme", "windows": ["compose"]},
  {"op": "assert", "window": "compose", "expect": [{"find": {"role": "popup", "label": "Serif"}, "exists": true}, {"model": "ext:session.theme", "equals": "serif"}, {"model": "ext:session.markdown", "equals": "true"}]},
  {"op": "ext", "id": "setField", "window": "compose", "name": "to", "text": "bob@local.test"},
  {"op": "ext", "id": "setField", "window": "compose", "name": "subject", "text": "U2 markdown {run}"},
  {"op": "ext", "id": "keyEquivalent", "window": "compose", "text": "cmd+return"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 20000},
  {"op": "ext", "id": "waitExt", "name": "pendingCount", "text": "0", "timeoutMs": 30000},

  {"op": "addAccount", "persona": "bob", "as": "bob", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "selectMailbox", "email": "bob@local.test", "text": "inbox"},
  {"op": "ext", "id": "selectMessage", "text": "=U2 markdown {run}", "timeoutMs": 40000},
  {"op": "ext", "id": "loadSource", "timeoutMs": 30000},
  {"op": "assert", "expect": [
    {"model": "ext:src.has:text/plain", "equals": "true"},
    {"model": "ext:src.has:text/html", "equals": "true"},
    {"model": "ext:src.has:# Heading", "equals": "true"},
    {"model": "ext:src.has:|---|---|", "equals": "true"},
    {"model": "ext:src.count:—", "equals": "0"},
    {"model": "ext:src.has:<table", "equals": "true"},
    {"model": "ext:src.has:font-family:Georgia", "equals": "true"},
    {"model": "ext:src.has:style=\"", "equals": "true"},
    {"model": "ext:src.count:<style", "equals": "0"},
    {"model": "ext:src.count:<img", "equals": "0"}
  ]},
  {"op": "quit"}
 ]
}
