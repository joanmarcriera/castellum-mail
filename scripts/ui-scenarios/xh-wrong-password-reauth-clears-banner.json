{
 "schema": 1,
 "name": "xh-wrong-password-reauth-clears-banner",
 "covers": [
  "wrong password after a password change: readable banner naming the account, banner Retry with the password still wrong keeps the banner and raises no modal, Re-authenticate with the right password clears banner + status"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1440,
  "height": 900,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xh-one@local.test",
   "password": "xh-one@local.test",
   "as": "one",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1300,
    600
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "one",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "breakPassword",
   "accountRef": "one"
  },
  {
   "op": "wait",
   "until": "sync:one=failed",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-wrong-password",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:syncBanner",
     "equals": "authenticationFailed: Sign-in failed for xh-one@local.test — check the username or password."
    },
    {
     "model": "errorText",
     "equals": ""
    },
    {
     "sheetAttached": false
    },
    {
     "windowCount": 1
    }
   ]
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "main",
   "text": "1148,67"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "4000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-retry-clicked-still-wrong",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:syncBanner",
     "equals": "authenticationFailed: Sign-in failed for xh-one@local.test — check the username or password."
    },
    {
     "model": "accounts:dotState:one",
     "equals": "authenticationFailed"
    },
    {
     "model": "errorText",
     "equals": ""
    },
    {
     "sheetAttached": false
    },
    {
     "windowCount": 1
    }
   ]
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "accounts",
   "accountRef": "one"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    760,
    560
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "03-settings-failed",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "accounts",
   "id": "pressExpect",
   "window": "settings",
   "find": {"label": "Re-authenticate…"},
   "name": "sheet:reauth"
  },
  {
   "op": "wait",
   "until": "sheet:reauth"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:reauth",
   "find": {
    "identifier": "password"
   },
   "text": "xh-one@local.test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "04-reauth-sheet",
   "windows": [
    "sheet:reauth"
   ]
  },
  {
   "op": "press",
   "window": "sheet:reauth",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:reauth",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "sync:one=ok",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "05-recovered"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:syncBanner",
     "equals": "none"
    },
    {
     "model": "accounts:dotState:one",
     "equals": "ok"
    },
    {
     "model": "errorText",
     "equals": ""
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}