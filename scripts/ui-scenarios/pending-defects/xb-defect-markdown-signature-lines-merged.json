{
 "schema": 1,
 "name": "xb-defect-markdown-signature-lines-merged",
 "covers": [
  "markdown compose",
  "with Markdown on, a multi-line signature must keep its line breaks in the HTML part the recipient reads (asserts a <br> after the first signature line; today the lines are one paragraph)"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "signature:alice@local.test",
   "text": "Alice Puig\nCastellum tester\n+34 600 000 000"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb md sig {run}"
  },
  {
   "op": "ext",
   "id": "composeSet",
   "window": "@compose",
   "name": "markdown",
   "value": true
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "compose-preview"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "bob@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb md sig {run}",
   "timeoutMs": 120000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "bob-reads",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:src.has:Castellum tester",
     "equals": "true"
    },
    {
     "model": "ext:src.has:Alice Puig<br",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}