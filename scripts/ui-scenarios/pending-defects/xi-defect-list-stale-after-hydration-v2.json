{
 "schema": 1,
 "name": "xi-defect-list-stale-after-hydration-v2",
 "covers": [
  "message list sorting",
  "after an IDLE-thread resync hydrates bodies (no new arrivals) the open list must show the new order and previews without re-selecting the mailbox"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xi-r4@local.test",
   "password": "xi-r4@local.test",
   "as": "xi",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "command",
   "id": "layoutClassic"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xi",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "30000",
   "timeoutMs": 50000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "open-list-30s-after-sync"
  },
  {
   "op": "assert",
   "label": "30 s after sync the open list must be in Date order (newest first), as it is after re-selecting the mailbox",
   "expect": [
    {
     "model": "reading:cell:subject:0",
     "equals": "xi future date"
    },
    {
     "model": "reading:cell:subject:1",
     "equals": "xi no date header"
    },
    {
     "model": "reading:cell:subject:2",
     "equals": "xi plain hello"
    },
    {
     "model": "reading:cell:subject:3",
     "equals": "xi html remote image"
    },
    {
     "model": "reading:cell:subject:4",
     "equals": "xi inline cid image"
    },
    {
     "model": "reading:cell:preview:1",
     "equals": "XI-NODATE-BODY"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectUnified",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xi",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "same-list-after-reselect"
  },
  {
   "op": "assert",
   "label": "control: the same mailbox, re-selected, is in Date order",
   "expect": [
    {
     "model": "reading:cell:subject:0",
     "equals": "xi future date"
    },
    {
     "model": "reading:cell:subject:1",
     "equals": "xi no date header"
    },
    {
     "model": "reading:cell:subject:2",
     "equals": "xi plain hello"
    },
    {
     "model": "reading:cell:subject:3",
     "equals": "xi html remote image"
    },
    {
     "model": "reading:cell:subject:4",
     "equals": "xi inline cid image"
    },
    {
     "model": "reading:cell:preview:1",
     "equals": "XI-NODATE-BODY"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}