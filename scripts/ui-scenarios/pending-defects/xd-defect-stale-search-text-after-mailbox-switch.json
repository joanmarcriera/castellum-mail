{
 "schema": 1,
 "name": "xd-defect-stale-search-text-after-mailbox-switch",
 "covers": [
  "search then switch mailbox"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "mailbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "2"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "field-says-quick-list-is-whole-inbox"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:mailboxRole",
     "equals": "inbox"
    },
    {
     "model": "reading:hasSubject:Invoice R0012345678",
     "equals": "true"
    }
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:searchText",
     "equals": ""
    }
   ]
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "upsertSmart",
   "name": "xd other",
   "text": "zebra"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectSmart",
   "text": "xd other"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "smart-mailbox-zebra-open-field-says-quick"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:Re: \"Budget\" v2: final",
     "equals": "true"
    },
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:searchText",
     "equals": ""
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}