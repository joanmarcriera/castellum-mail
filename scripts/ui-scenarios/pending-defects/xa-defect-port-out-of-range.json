{
 "schema": 1,
 "name": "xa-defect-port-out-of-range",
 "covers": [
  "A port outside 1-65535 must not be accepted by the Add sheet (today Sync is enabled and the failure is a raw 'CastellumError error 2')"
 ],
 "requires": {
  "greenmail": false,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "99999"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "7",
   "text": "3025"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,270"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,442"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "4000"
  },
  {
   "op": "capture",
   "name": "01-port-99999",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "text": "CastellumError"
     },
     "exists": false
    }
   ]
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "cancel"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
