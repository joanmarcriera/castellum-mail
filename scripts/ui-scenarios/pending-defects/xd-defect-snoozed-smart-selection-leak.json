{
 "schema": 1,
 "name": "xd-defect-snoozed-smart-selection-leak",
 "covers": [
  "smart mailboxes",
  "Snoozed",
  "sidebar selection"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "upsertSmart",
   "name": "xd quick",
   "text": "quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectSmart",
   "text": "xd quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "2"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectSnoozed"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:isSnoozedList",
     "equals": "true"
    },
    {
     "model": "reading:messageCount",
     "equals": "0"
    },
    {
     "model": "reading:smartSelected",
     "equals": "none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "sync:xd=ok",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "snoozed-list-replaced-by-smart-mailbox-after-sync"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:isSnoozedList",
     "equals": "true"
    },
    {
     "model": "reading:messageCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectSnoozed"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectSmart",
   "text": "xd quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:smartSelected",
     "equals": "xd quick"
    },
    {
     "model": "reading:isSnoozedList",
     "equals": "false"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}