{ "schema": 1, "name": "xg-defect-ai-tab-clipped-after-test",
  "covers": ["Settings > AI after a successful Test Connection (local Ollama on 127.0.0.1:11434 required) at the minimum window size: the model pickers, Show AI Activity and Learn more must stay reachable (the pane is a Form with no ScrollView)"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25}, "timeoutMs": 60000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "ext", "id": "setPref", "name": "aiEnabled", "text": "true"},
    {"op": "ext", "id": "setPref", "name": "aiEndpoint", "text": "http://127.0.0.1:11434"},
    {"op": "wait", "until": "settingsOpenerReady", "timeoutMs": 15000},
    {"op": "openWindow", "target": "settings", "tab": "ai"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "click", "window": "settings", "text": "239,292"},
    {"op": "accounts", "id": "waitNode", "window": "settings", "find": {"role": "popup", "label": "Select a model…"}, "value": true, "timeoutMs": 10000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-ai-tested-min", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText", "controlsReachable"],
     "expect": [{"find": {"role": "popup", "label": "Select a model…"}, "exists": true, "visible": true},
                {"find": {"role": "popup", "label": "None (no background indexing)"}, "exists": true, "visible": true}]},
    {"op": "quit"} ] }
