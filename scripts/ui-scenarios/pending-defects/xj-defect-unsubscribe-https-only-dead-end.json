{
 "schema": 1,
 "name": "xj-defect-unsubscribe-https-only-dead-end",
 "covers": [
  "S44 List-Unsubscribe",
  "RFC 2369 https link without List-Unsubscribe-Post",
  "xj defect"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xj-org1@local.test",
   "password": "xj-org1@local.test",
   "as": "xj",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xj",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XJ Shop offers (https only)"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "unsubscribe-link-offered"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "main",
   "text": "928,145",
   "name": "sheet:unsub"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "700"
  },
  {
   "op": "wait",
   "until": "sheet:unsub"
  },
  {
   "op": "capture",
   "name": "sheet-says-no-link"
  },
  {
   "op": "assert",
   "window": "sheet:unsub",
   "rules": [
    "nonBlank"
   ],
   "expect": [
    {
     "find": {
      "role": "staticText"
     },
     "exists": true
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}