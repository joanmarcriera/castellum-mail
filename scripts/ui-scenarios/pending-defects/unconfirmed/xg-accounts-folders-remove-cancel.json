{
 "schema": 1,
 "name": "xg-accounts-folders-remove-cancel",
 "covers": [
  "Settings > Accounts: Folders\u2026 sheet layout and Cancel; Remove\u2026 and Reset\u2026 confirmation alerts cancelled half-way leave the account in place"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 150000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "carol",
   "as": "carol",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady",
   "timeoutMs": 15000
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "accounts",
   "accountRef": "carol"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    900,
    700
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "settings",
   "text": "571,678",
   "name": "sheet:folders"
  },
  {
   "op": "wait",
   "until": "sheet:folders",
   "timeoutMs": 5000
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-folders-sheet"
  },
  {
   "op": "assert",
   "window": "sheet:folders",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "onScreen",
    "noClippedText",
    "primaryButtonsVisible"
   ]
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:folders",
   "text": "53,186"
  },
  {
   "op": "wait",
   "until": "noSheet:folders",
   "timeoutMs": 5000
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "800"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "settings",
   "text": "848,678",
   "name": "sheet:remove"
  },
  {
   "op": "wait",
   "until": "sheet:remove",
   "timeoutMs": 5000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-remove-alert",
   "windows": [
    "sheet:remove",
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:remove",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "primaryButtonsVisible"
   ],
   "expect": [
    {
     "find": {
      "role": "button",
      "label": "Cancel"
     },
     "exists": true,
     "visible": true
    },
    {
     "find": {
      "role": "button",
      "label": "Remove"
     },
     "exists": true
    }
   ]
  },
  {
   "op": "press",
   "window": "sheet:remove",
   "find": {
    "role": "button",
    "label": "Cancel"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:remove",
   "timeoutMs": 5000
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "800"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "settings",
   "text": "764,678",
   "name": "sheet:reset"
  },
  {
   "op": "wait",
   "until": "sheet:reset",
   "timeoutMs": 5000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "03-reset-alert",
   "windows": [
    "sheet:reset"
   ]
  },
  {
   "op": "press",
   "window": "sheet:reset",
   "find": {
    "role": "button",
    "label": "Cancel"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:reset",
   "timeoutMs": 5000
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "800"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "04-after-cancels",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "noClippedText"
   ],
   "expect": [
    {
     "model": "accountCount",
     "equals": "1"
    },
    {
     "model": "accountSync:carol",
     "equals": "ok"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}