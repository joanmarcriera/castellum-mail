{ "schema": 1, "name": "xa-explore-bad",
  "covers": ["exploration: unreachable port, wrong host, odd ports, cancel after failures, blank email"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 240000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "resizeWindow", "window": "main", "contentSize": [1200, 690]},
    {"op": "wait", "until": "idle"},
    {"op": "openSheet", "target": "addAccount"},
    {"op": "wait", "until": "sheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "email"}, "text": "xa-one@local.test"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "imapHost"}, "text": "127.0.0.1"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "3", "text": "3999"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "password"}, "text": "xa-one@local.test"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "7", "text": "3025"},
    {"op": "accounts", "id": "click", "window": "sheet:addAccount", "text": "179,270"},
    {"op": "accounts", "id": "click", "window": "sheet:addAccount", "text": "179,442"},
    {"op": "wait", "until": "idle"},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "sync"}},
    {"op": "accounts", "id": "settle", "text": "4000"},
    {"op": "capture", "name": "01-unreachable-port"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "imapHost"}, "text": "no-such-host.invalid"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "3", "text": "3143"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-edited-after-failure", "windows": ["sheet:addAccount"]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "sync"}},
    {"op": "accounts", "id": "settle", "text": "7000"},
    {"op": "capture", "name": "03-wrong-host", "windows": ["sheet:addAccount"]},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "imapHost"}, "text": "127.0.0.1"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "3", "text": "99999"},
    {"op": "wait", "until": "idle"},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "sync"}, "enabled": false} ]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "sync"}},
    {"op": "accounts", "id": "settle", "text": "4000"},
    {"op": "capture", "name": "04-port-99999", "windows": ["sheet:addAccount"]},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "3", "text": "abc"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "05-port-abc", "windows": ["sheet:addAccount"]},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "sync"}, "enabled": false}, {"find": {"identifier": "testConnection"}, "enabled": false} ]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "06-main-after-cancel", "windows": ["main"]},
    {"op": "assert", "expect": [ {"model": "accountCount", "equals": "0"}, {"model": "reading:syncBanner", "equals": "none"}, {"model": "accounts:dotState:xa-one@local.test", "equals": "none"}, {"model": "errorText", "equals": ""} ]},
    {"op": "openSheet", "target": "addAccount"},
    {"op": "wait", "until": "sheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "07-reopened-sheet", "windows": ["sheet:addAccount"]},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "imapHost"}, "text": "127.0.0.1"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "3", "text": "3143"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "username"}, "text": "xa-two@local.test"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "password"}, "text": "xa-two@local.test"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAccount", "name": "7", "text": "3025"},
    {"op": "accounts", "id": "click", "window": "sheet:addAccount", "text": "179,270"},
    {"op": "accounts", "id": "click", "window": "sheet:addAccount", "text": "179,442"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "08-blank-email-filled", "windows": ["sheet:addAccount"]},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "sync"}, "enabled": false} ]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "sync"}},
    {"op": "accounts", "id": "settle", "text": "6000"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "09-after-blank-email-sync"},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "10-settings-blank-email-account", "windows": ["settings"]},
    {"op": "assert", "expect": [ {"model": "accountCount", "equals": "0"}, {"model": "accounts:sidebarLabel:127.0.0.1", "equals": "?"}, {"model": "accounts:fromHeader:127.0.0.1", "equals": "?"} ]},
    {"op": "quit"} ] }
