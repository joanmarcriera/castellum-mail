{ "schema": 1, "name": "xa-explore-shift",
  "covers": ["exploration: is the second-account sheet really shifted left (PNG) or is that a capture artifact"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 120000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "resizeWindow", "window": "main", "contentSize": [1200, 690]},
    {"op": "addAccount", "persona": "dave", "as": "dave", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "00-main-dave-empty", "windows": ["main"]},
    {"op": "assert", "expect": [ {"model": "reading:mailboxRole", "equals": "x"}, {"model": "reading:isUnified", "equals": "x"}, {"model": "reading:messageCount", "equals": "x"} ]},
    {"op": "reading", "id": "selectMailbox", "accountRef": "dave", "text": "inbox"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "00b-main-dave-inbox", "windows": ["main"]},
    {"op": "openSheet", "target": "addAccount"},
    {"op": "wait", "until": "sheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "click", "window": "sheet:addAccount", "text": "5,626"},
    {"op": "accounts", "id": "settle", "text": "800"},
    {"op": "assert", "expect": [ {"sheetAttached": false} ]},
    {"op": "accounts", "id": "click", "window": "sheet:addAccount", "text": "75,626"},
    {"op": "accounts", "id": "settle", "text": "800"},
    {"op": "assert", "expect": [ {"sheetAttached": false} ]},
    {"op": "quit"} ] }
