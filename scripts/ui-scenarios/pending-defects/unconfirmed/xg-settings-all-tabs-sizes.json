{
 "schema": 1,
 "name": "xg-settings-all-tabs-sizes",
 "covers": [
  "Settings: every reachable tab (general, ai, accounts, rules, tags, licence) at default, minimum and 1100x700, English"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady",
   "timeoutMs": 15000
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "general-default",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "general-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "noClippedText",
    "controlsReachable",
    "noZeroSizeTextFields"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    1100,
    700
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "general-large",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "noClippedText"
   ]
  },
