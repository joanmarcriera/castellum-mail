{ "schema": 1, "name": "xa-explore-dup",
  "covers": ["exploration: second-account sheet, same account twice, capitals and spaces"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "resizeWindow", "window": "main", "contentSize": [1200, 690]},
    {"op": "addAccount", "email": "xa-one@local.test", "password": "xa-one@local.test", "as": "one", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "idle"},
    {"op": "openSheet", "target": "addAccount"},
    {"op": "wait", "until": "sheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-second-account-sheet", "windows": ["sheet:addAccount"]},
    {"op": "assert", "window": "sheet:addAccount", "rules": ["primaryButtonsVisible", "noClippedText", "controlsReachable"]},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "email"}, "text": "xa-one@local.test"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "imapHost"}, "text": "127.0.0.1"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "password"}, "text": "xa-one@local.test"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-same-email", "windows": ["sheet:addAccount"]},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "sync"}, "enabled": false}, {"find": {"text": "already exists"}, "exists": true} ]},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "email"}, "text": "XA-One@Local.Test"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-capitals", "windows": ["sheet:addAccount"]},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "sync"}, "enabled": false} ]},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "email"}, "text": "xa-one@local.test "},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "04-trailing-space", "windows": ["sheet:addAccount"]},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "sync"}, "enabled": false} ]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:addAccount"},
    {"op": "addAccount", "email": "XA-One@Local.Test", "password": "xa-one@local.test", "as": "caps", "waitFor": "none"},
    {"op": "addAccount", "email": "xa-one@local.test ", "password": "xa-one@local.test", "as": "space", "waitFor": "none"},
    {"op": "accounts", "id": "settle", "text": "8000"},
    {"op": "wait", "until": "idle"},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "05-settings-accounts", "windows": ["settings"]},
    {"op": "assert", "expect": [ {"model": "accountCount", "equals": "1"}, {"model": "accounts:dotState:caps", "equals": "none"}, {"model": "accounts:dotMessage:space", "equals": "none"} ]},
    {"op": "quit"} ] }
