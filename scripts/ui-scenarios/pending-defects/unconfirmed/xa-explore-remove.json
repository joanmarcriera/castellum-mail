{
 "schema": 1,
 "name": "xa-explore-remove",
 "covers": [
  "exploration: remove an account while the unified inbox shows its mail"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 200000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "addAccount",
   "email": "xa-one@local.test",
   "password": "xa-one@local.test",
   "as": "one",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "addAccount",
   "email": "xa-two@local.test",
   "password": "xa-two@local.test",
   "as": "two",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectUnified",
   "text": "inbox"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XA two only message"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-unified-before",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "4"
    },
    {
     "model": "reading:selectedSubject",
     "equals": "XA two only message"
    }
   ]
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "accounts",
   "accountRef": "two"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    760,
    560
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-settings-two-selected",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "settings",
   "text": "624,538",
   "name": "sheet:reset"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "capture",
   "name": "03-reset-confirm"
  },
  {
   "op": "assert",
   "expect": [
    {
     "windowCount": 9
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}