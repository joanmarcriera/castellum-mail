{
 "schema": 1,
 "name": "xf-defect-mark-all-read-ignores-search-v2",
 "covers": [
  "mark-all-read",
  "search",
  "read"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xf-qv1791216526@local.test",
   "password": "xf-qv1791216526@local.test",
   "as": "q",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xf-qv1791216526@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "q",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "is:unread"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "700"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "5"
    }
   ],
   "label": "precondition: 5 unread before the search"
  },
  {
   "op": "search",
   "text": "XF q msg 2"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "700"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:hasSubject:XF q msg 2",
     "equals": "true"
    }
   ],
   "label": "the search lists one message"
  },
  {
   "op": "capture",
   "name": "search-shows-one"
  },
  {
   "op": "command",
   "id": "markAllRead",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1000"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "700"
  },
  {
   "op": "capture",
   "name": "inbox-after-mark-all"
  },
  {
   "op": "search",
   "text": "is:unread"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "700"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "4"
    }
   ],
   "label": "Mark All as Read with a search showing 1 message must leave the 4 messages the search hid unread"
  },
  {
   "op": "quit"
  }
 ]
}