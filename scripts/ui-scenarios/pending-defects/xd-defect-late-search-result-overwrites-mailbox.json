{
 "schema": 1,
 "name": "xd-defect-late-search-result-overwrites-mailbox",
 "covers": [
  "search then switch mailbox",
  "runSearch has no listToken guard"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "all"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "is:unread"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "xd-inbox-selected-but-list-is-search-result"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:mailboxRole",
     "equals": "inbox"
    },
    {
     "model": "reading:messageCount",
     "equals": "10"
    },
    {
     "model": "reading:hasSubject:Invoice R0012345678",
     "equals": "false"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}