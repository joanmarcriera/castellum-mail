{
 "schema": 1,
 "name": "xa-defect-blank-email-account",
 "covers": [
  "Add sheet with the Email field empty (username filled) must not offer Sync: it creates an account with no address, no sidebar name and an empty From"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "3143"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "username"
   },
   "text": "xa-two@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-two@local.test"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "7",
   "text": "3025"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,270"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,442"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-blank-email-filled",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "6000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "accounts"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    760,
    560
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-settings-nameless-account",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
