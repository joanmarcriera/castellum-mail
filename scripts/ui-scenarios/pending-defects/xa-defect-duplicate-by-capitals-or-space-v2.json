{
 "schema": 1,
 "name": "xa-defect-duplicate-by-capitals-or-space-v2",
 "covers": [
  "Add account sheet refuses (Sync disabled) an address that differs from an existing account only by capitals or surrounding whitespace; sheet-only, no harness addAccount bypass"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 220000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "addAccount",
   "email": "xa-one@local.test",
   "password": "xa-one@local.test",
   "as": "one",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "XA-One@Local.Test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-capitals",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test "
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-trailing-space",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "cancel"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}