{
 "schema": 1,
 "name": "xf-defect-archived-mail-vanishes",
 "covers": [
  "archive",
  "search"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xf-k@local.test",
   "password": "xf-k@local.test",
   "as": "k",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xf-k@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "k",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF k msg 3"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "6000"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "k",
   "text": "archive"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "archive-mailbox-after-archiving"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XF k msg 3",
     "equals": "true"
    }
   ],
   "label": "the Archive mailbox lists the message just archived"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "k",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "account"
  },
  {
   "op": "search",
   "text": "XF k msg 3"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "900"
  },
  {
   "op": "capture",
   "name": "account-search"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XF k msg 3",
     "equals": "true"
    }
   ],
   "label": "an account-wide search still finds it"
  },
  {
   "op": "quit"
  }
 ]
}