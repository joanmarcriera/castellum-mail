{
 "schema": 1,
 "name": "xd-defect-smart-count-stale-after-read",
 "covers": [
  "smart mailboxes",
  "counts sidebar vs list"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "upsertSmart",
   "name": "xd unread fox",
   "text": "is:unread from:fox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectSmart",
   "text": "xd unread fox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "2"
    },
    {
     "model": "reading:smartTotal:xd unread fox",
     "equals": "2"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xd phrase one"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "selectedUnread",
   "text": "false",
   "timeoutMs": 20000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectSmart",
   "text": "xd unread fox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "list-has-1-sidebar-count-still-2"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:smartTotal:xd unread fox",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}