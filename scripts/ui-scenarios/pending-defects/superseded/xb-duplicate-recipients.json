{
 "schema": 1,
 "name": "xb-duplicate-recipients",
 "covers": [
  "compose",
  "the same address typed twice (To and Cc, different case) is delivered once"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "bob@local.test, bob@local.test, Bob Ferrer <BOB@local.test>"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "cc",
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb dup {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Once is enough."
  },
  {
   "op": "capture",
   "name": "dup-typed"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "bob@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb dup {run}",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "3000"
  },
  {
   "op": "capture",
   "name": "bob-inbox",
   "windows": [
    "main"
   ]
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:messageCount:xb dup {run}",
     "equals": "1"
    }
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:src.count:bob@local.test",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}