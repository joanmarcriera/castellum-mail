{
 "schema": 1,
 "name": "xe-defect-rule-moves-into-unsynced-folder",
 "covers": [
  "MM-3",
  "DEFECT: Move to... offers a folder Castellum does not sync (unsubscribed); after the rule runs the mail is in neither the Inbox nor the destination list"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xe-r1@local.test",
   "password": "xe-r1@local.test",
   "as": "r1",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "setWrite",
   "accountRef": "r1",
   "value": true
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "File invoices",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"subject\", \"operator\": \"contains\", \"value\": \"XE Invoice\"}], \"groups\": []}, \"actions\": [{\"move\": {\"mailbox_id\": \"xe-r1@local.test:Receipts\"}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "File invoices",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "2 matched, 2 actions queued."
    }
   ]
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 45000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "r1",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XE Invoice 1001",
     "equals": "false"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "r1",
   "text": "Receipts"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "10000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "destination-folder-empty",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:XE Invoice 1001",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}