{
 "schema": 1,
 "name": "xc-defect-html-reply-quote-merges-blocks",
 "covers": [
  "DEFECT: the quote of an HTML-only mail must keep block boundaries (heading and paragraph on separate lines)"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xc-me@local.test",
   "password": "xc-me@local.test",
   "imap": "127.0.0.1:3143",
   "smtp": "127.0.0.1:3025",
   "tls": false,
   "as": "me",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "me",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC html only"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "html-quote"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:bodyHas:> Regards,",
     "equals": "true"
    },
    {
     "model": "ext:bodyHas:numbersRevenue",
     "equals": "false"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}