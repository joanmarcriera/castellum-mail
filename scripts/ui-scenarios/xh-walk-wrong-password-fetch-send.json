{
 "schema": 1,
 "name": "xh-walk-wrong-password-fetch-send",
 "covers": [
  "wrong password mid-session: open a message whose body is not local, then send; what the reading pane and the compose window say",
  "needs xh-body@local.test seeded (build/explore/xh/seed.py)"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1440,
  "height": 900,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xh-body@local.test",
   "password": "xh-body@local.test",
   "as": "body",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1300,
    600
   ]
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xh-body@local.test"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "body",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "breakPassword",
   "accountRef": "body"
  },
  {
   "op": "wait",
   "until": "sync:body=failed",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XH big body"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "3000"
  },
  {
   "op": "capture",
   "name": "01-body-fetch-wrong-password",
   "windows": [
    "main"
   ]
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "wait",
   "until": "window:compose"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "to",
   "text": "xh-rcpt@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "subject",
   "text": "XH wrongpw send {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "compose",
   "text": "Sent with a stale password."
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "compose",
   "text": "cmd+return"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "6000"
  },
  {
   "op": "capture",
   "name": "02-after-send"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "errorText",
     "equals": ""
    },
    {
     "sheetAttached": false
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}