{ "schema": 1, "name": "u1-s8-s13-sync-status",
  "covers": ["S8", "N/A", "S13", "N/A", "S73", "N/A", "Sync status: no modal on sync failure, human-first message, banner, Status dashboard, Retry, Accounts..."],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 240000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "addAccount", "persona": "bob", "as": "bob", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "status"},
    {"op": "wait", "until": "window:status"},
    {"op": "resizeWindow", "window": "status", "contentSize": [620, 460]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-status-all-healthy"},
    {"op": "assert", "window": "status", "rules": ["nonBlank", "fitsScreen", "noClippedText"],
     "expect": [
       {"model": "accounts:dotState:alice", "equals": "ok"},
       {"model": "accounts:dotState:bob", "equals": "ok"} ]},
    {"op": "accounts", "id": "setEndpoint", "accountRef": "bob", "text": "127.0.0.1:3999"},
    {"op": "wait", "until": "sync:bob=failed", "timeoutMs": 60000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-bob-unreachable-no-modal"},
    {"op": "assert", "window": "status", "rules": ["nonBlank", "fitsScreen", "noClippedText"],
     "expect": [
       {"model": "accounts:dotState:bob", "equals": "unreachable"},
       {"model": "accounts:dotMessage:bob", "equals": "Can’t reach 127.0.0.1:3999 — the connection failed."},
       {"model": "accounts:dotState:alice", "equals": "ok"},
       {"model": "errorText", "equals": ""},
       {"sheetAttached": false},
       {"windowCount": 2} ]},
    {"op": "accounts", "id": "waitNode", "window": "status", "find": {"identifier": "statusRow", "text": ": unreachable. Can’t reach 127.0.0.1:3999"}, "value": true, "timeoutMs": 10000},
    {"op": "accounts", "id": "waitNode", "window": "status", "find": {"identifier": "statusRow", "text": ": syncing"}, "value": false, "timeoutMs": 5000},
    {"op": "accounts", "id": "waitNode", "window": "status", "find": {"identifier": "retry", "text": "Retry sync for bob@local.test"}, "value": true, "timeoutMs": 5000},
    {"op": "accounts", "id": "click", "window": "status", "text": "562,437", "name": "diagnostics"},
    {"op": "wait", "until": "window:diagnostics"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-diagnostics-from-status"},
    {"op": "closeWindow", "window": "diagnostics"},
    {"op": "accounts", "id": "setEndpoint", "accountRef": "bob", "text": "127.0.0.1:3143", "value": false},
    {"op": "wait", "until": "idle"},
    {"op": "assert", "expect": [ {"model": "accounts:dotState:bob", "equals": "unreachable"} ]},
    {"op": "accounts", "id": "click", "window": "status", "text": "510,110"},
    {"op": "wait", "until": "sync:bob=ok", "timeoutMs": 60000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "04-bob-recovered-after-retry"},
    {"op": "assert", "window": "status", "rules": ["nonBlank"], "expect": [
       {"model": "accounts:dotState:bob", "equals": "ok"},
       {"model": "accounts:endpoint:bob", "equals": "127.0.0.1:3143"} ]},
    {"op": "accounts", "id": "click", "window": "status", "text": "570,110", "name": "settings"},
    {"op": "wait", "until": "window:settings"},
    {"op": "wait", "until": "idle"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "05-accounts-button-opens-settings-on-bob"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen"]},
    {"op": "quit"} ] }
