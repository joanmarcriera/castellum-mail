{ "schema": 1, "name": "u1-gui2-add-account-flow",
  "covers": ["GUI-2", "N/A", "PR-189", "S70", "N/A", "Display name in sidebar and compose From"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "dave", "as": "dave", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "dave"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Add…"}, "name": "sheet:addAlice"},
    {"op": "wait", "until": "sheet:addAlice"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "popupSelect", "window": "sheet:addAlice", "find": {"role": "popup", "label": "None"}, "text": "dave@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "email"}, "text": "alice@local.test"},
    {"op": "accounts", "id": "setNth", "window": "sheet:addAlice", "name": "1", "text": "Alice Lead"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "username"}, "text": "alice@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "password"}, "text": "alice-pass"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "smtpUsername"}, "text": "alice@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "smtpPassword"}, "text": "alice-pass"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "alice-filled"},
    {"op": "assert", "window": "sheet:addAlice", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible", "noZeroSizeTextFields"],
     "expect": [
       {"find": {"identifier": "sync"}, "enabled": true},
       {"model": "accounts:field:sheet:addAlice|#1", "equals": "Alice Lead"} ]},
    {"op": "press", "window": "sheet:addAlice", "find": {"identifier": "sync"}},
    {"op": "accounts", "id": "waitNode", "window": "sheet:addAlice", "find": {"identifier": "cancel"}, "value": false, "timeoutMs": 30000},
    {"op": "capture", "name": "alice-connecting"},
    {"op": "accounts", "id": "click", "window": "sheet:addAlice", "text": "60,496"},
    {"op": "wait", "until": "noSheet:addAlice"},
    {"op": "capture", "name": "after-continue-in-background"},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Add…"}, "name": "sheet:addBob"},
    {"op": "wait", "until": "sheet:addBob"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "popupSelect", "window": "sheet:addBob", "find": {"role": "popup", "label": "None"}, "text": "dave@local.test"},
    {"op": "setText", "window": "sheet:addBob", "find": {"identifier": "email"}, "text": "bob@local.test"},
    {"op": "setText", "window": "sheet:addBob", "find": {"identifier": "username"}, "text": "bob@local.test"},
    {"op": "setText", "window": "sheet:addBob", "find": {"identifier": "password"}, "text": "bob-pass"},
    {"op": "setText", "window": "sheet:addBob", "find": {"identifier": "smtpUsername"}, "text": "bob@local.test"},
    {"op": "setText", "window": "sheet:addBob", "find": {"identifier": "smtpPassword"}, "text": "bob-pass"},
    {"op": "wait", "until": "sync:alice@local.test=ok", "timeoutMs": 60000},
    {"op": "accounts", "id": "settle", "text": "1500"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "bob-sheet-after-alice-synced"},
    {"op": "assert", "window": "sheet:addBob", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible"],
     "expect": [
       {"find": {"identifier": "testConnection"}, "enabled": true},
       {"find": {"identifier": "cancel"}, "visible": true},
       {"model": "accounts:dotState:alice@local.test", "equals": "ok"},
       {"model": "accounts:sidebarLabel:alice@local.test", "equals": "Alice Lead"},
       {"model": "accounts:fromHeader:alice@local.test", "equals": "Alice Lead <alice@local.test>"} ]},
    {"op": "press", "window": "sheet:addBob", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:addBob"},
    {"op": "assert", "expect": [ {"model": "accountCount", "equals": "2"} ]},
    {"op": "openWindow", "target": "compose"},
    {"op": "wait", "until": "window:compose"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "compose-from"},
    {"op": "assert", "window": "compose", "rules": ["nonBlank", "fitsScreen"],
     "expect": [ {"find": {"text": "Alice Lead"}, "visible": true} ]},
    {"op": "quit"} ] }
