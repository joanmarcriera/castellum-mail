{
 "schema": 1,
 "name": "xg-general-full-height",
 "covers": [
  "Settings > General shown whole (900x1300) and at the minimum width (480x1300): every section, including Key Bindings, Default Mail App and Updates that need scrolling at normal heights"
 ],
 "requires": {
  "greenmail": false,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 60000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady",
   "timeoutMs": 15000
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    900,
    1300
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-general-900x1300",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    480,
    1300
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-general-480x1300",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "noClippedText",
    "noZeroSizeTextFields"
   ]
  },
  {
   "op": "quit"
  }
 ]
}