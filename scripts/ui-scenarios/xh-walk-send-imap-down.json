{
 "schema": 1,
 "name": "xh-walk-send-imap-down",
 "covers": [
  "offline walk: IMAP unreachable but SMTP fine; send with writes enabled; exactly one delivery, what is queued, what happens on recovery"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1440,
  "height": 900,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xh-one@local.test",
   "password": "xh-one@local.test",
   "as": "one",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1300,
    600
   ]
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xh-one@local.test"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "accounts",
   "id": "setEndpoint",
   "accountRef": "one",
   "text": "127.0.0.1:3999"
  },
  {
   "op": "wait",
   "until": "sync:one=failed",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "wait",
   "until": "window:compose"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "to",
   "text": "xh-rcpt@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "subject",
   "text": "XH imapdown {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "compose",
   "text": "IMAP is down, SMTP is up."
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "compose",
   "text": "cmd+return"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "6000"
  },
  {
   "op": "capture",
   "name": "01-after-send"
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "outbox"
  },
  {
   "op": "wait",
   "until": "window:outbox"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "02-outbox-imap-down"
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "4000"
  },
  {
   "op": "capture",
   "name": "03-after-resync-still-down"
  },
  {
   "op": "accounts",
   "id": "setEndpoint",
   "accountRef": "one",
   "text": "127.0.0.1:3143"
  },
  {
   "op": "wait",
   "until": "sync:one=ok",
   "timeoutMs": 60000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "3000"
  },
  {
   "op": "capture",
   "name": "04-recovered-queue-drained"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "outbox",
   "text": "508,378"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "05-outbox-after-manual-refresh",
   "windows": [
    "outbox"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "errorText",
     "equals": ""
    },
    {
     "model": "reading:syncBanner",
     "equals": "none"
    }
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "0"
    },
    {
     "model": "ext:composeWindows",
     "equals": "0"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}