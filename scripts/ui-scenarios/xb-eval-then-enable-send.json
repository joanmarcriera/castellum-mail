{
 "schema": 1,
 "name": "xb-eval-then-enable-send",
 "covers": [
  "write safety",
  "Send is refused in evaluation mode with the enable-writes hint and nothing is queued; after enabling writes the same window sends once"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb eval then on {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Only after writes are on."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "refused"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:composeWindows",
     "equals": "1"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    },
    {
     "model": "ext:undoBanner",
     "equals": "hidden"
    }
   ]
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "500"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-send",
   "windows": [
    "main"
   ]
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "bob@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb eval then on {run}",
   "timeoutMs": 120000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "messageCount:xb eval then on {run}",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "quit"
  }
 ]
}