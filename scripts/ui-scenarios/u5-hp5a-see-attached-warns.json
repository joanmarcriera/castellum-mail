{
 "schema": 1,
 "name": "u5-hp5a-see-attached-warns",
 "covers": [
  "HP5a",
  "N/A"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "5"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "wait",
   "until": "window:compose"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "to",
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "subject",
   "text": "U5 HP5a warn {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "compose",
   "text": "Hi Bob, please see attached the report."
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "compose-see-attached"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "compose",
   "text": "cmd+return"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "after-send-press-warning"
  },
  {
   "op": "quit"
  }
 ]
}