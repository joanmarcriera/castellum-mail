{
 "schema": 1,
 "name": "u2-mm5b-inline-image",
 "covers": [
  "MM-5b",
  "inline images in Markdown mail",
  "N/A"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 170000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "wait",
   "until": "window:compose"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "composeSet",
   "window": "compose",
   "name": "markdown",
   "value": true
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "compose",
   "text": "Before the picture.\n\nAfter the picture."
  },
  {
   "op": "ext",
   "id": "composeEmbedImage",
   "window": "compose",
   "text": "Shot.png"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "session.inlineCount",
   "text": "1",
   "timeoutMs": 20000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "compose-with-image",
   "windows": [
    "compose"
   ]
  },
  {
   "op": "assert",
   "window": "compose",
   "expect": [
    {
     "model": "ext:session.inlineCount",
     "equals": "1"
    },
    {
     "model": "ext:session.bodyHas:![Shot](cid:img-",
     "equals": "true"
    }
   ]
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "to",
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "compose",
   "name": "subject",
   "text": "U2 inline image {run}"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "bob@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=U2 inline image {run}",
   "timeoutMs": 40000
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:src.has:multipart/related",
     "equals": "true"
    },
    {
     "model": "ext:src.has:multipart/alternative",
     "equals": "true"
    },
    {
     "model": "ext:src.has:Content-ID: <img-",
     "equals": "true"
    },
    {
     "model": "ext:src.has:src=\"cid:img-",
     "equals": "true"
    },
    {
     "model": "ext:src.count:<img src=\"cid:img-",
     "equals": "1"
    },
    {
     "model": "ext:src.count:<img src=\"http",
     "equals": "0"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}