{
 "schema": 1,
 "name": "xd-search-scope-two-accounts",
 "covers": [
  "search scope: mailbox / account / all",
  "searching then switching scope"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "mailbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "subject:invoice"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "account"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "all"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:Invoice R0012345678",
     "equals": "true"
    }
   ]
  },
  {
   "op": "capture",
   "name": "scope-all"
  },
  {
   "op": "search",
   "text": "quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "2"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectUnified",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "mailbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "search",
   "text": "quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "2"
    },
    {
     "model": "reading:isUnified",
     "equals": "true"
    }
   ]
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:isUnified",
     "equals": "true"
    },
    {
     "model": "reading:hasSubject:xd phrase one",
     "equals": "true"
    },
    {
     "model": "reading:hasSubject:Invoice R0012345678",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}