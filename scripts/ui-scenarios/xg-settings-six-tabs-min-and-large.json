{
 "schema": 1,
 "name": "xg-settings-six-tabs-min-and-large",
 "covers": [
  "Settings: the seven tabs (general, ai, accounts, rules, notifications, tags, licence) at the minimum size and at 900x640 with one account: window stays resizable, movable, on screen and not blank at the minimum"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 200000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady",
   "timeoutMs": 15000
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "general-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "resizable",
    "movable"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    900,
    640
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "general-900x640",
