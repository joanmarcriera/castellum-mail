{ "schema": 1, "name": "u5-f3-add-account-wrong-password",
  "covers": ["F3", "N/A", "Add account with a wrong password says sign-in failed, not a network error"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "dave", "as": "dave", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "dave"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Add…"}, "name": "sheet:addAlice"},
    {"op": "wait", "until": "sheet:addAlice"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "popupSelect", "window": "sheet:addAlice", "find": {"role": "popup", "label": "None"}, "text": "dave@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "email"}, "text": "alice@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "username"}, "text": "alice@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "password"}, "text": "definitely-the-wrong-password"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "smtpUsername"}, "text": "alice@local.test"},
    {"op": "setText", "window": "sheet:addAlice", "find": {"identifier": "smtpPassword"}, "text": "definitely-the-wrong-password"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "wrong-password-filled"},
    {"op": "press", "window": "sheet:addAlice", "find": {"identifier": "testConnection"}},
    {"op": "accounts", "id": "settle", "text": "6000"},
    {"op": "capture", "name": "after-test-connection"},
    {"op": "assert", "window": "sheet:addAlice", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible", "noClippedText"],
     "expect": [ {"find": {"text": "IMAP sign-in to 127.0.0.1:3143 failed"}, "exists": true},
                 {"find": {"text": "SMTP sign-in to 127.0.0.1:3025 failed"}, "exists": true},
                 {"find": {"text": "annot reach"}, "exists": false}, {"find": {"text": "onnection refused"}, "exists": false} ]},
    {"op": "press", "window": "sheet:addAlice", "find": {"identifier": "sync"}},
    {"op": "accounts", "id": "settle", "text": "8000"},
    {"op": "capture", "name": "after-sync-press"},
    {"op": "quit"} ] }
