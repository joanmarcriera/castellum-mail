{
 "schema": 1,
 "name": "xi-missing-headers-and-empty-body",
 "covers": [
  "no Subject header",
  "empty Subject",
  "no From header",
  "no Date header",
  "future Date",
  "empty body",
  "duplicate Message-ID keeps both messages"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xi-r4@local.test",
   "password": "xi-r4@local.test",
   "as": "xi",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1270,
    720
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xi",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "8000",
   "timeoutMs": 28000
  },
  {
   "op": "reading",
   "id": "selectUnified",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xi",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "40"
    }
   ]
  },
  {
   "op": "search",
   "text": "XI-NOSUBJECT-BODY"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800",
   "timeoutMs": 20800
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:cell:subject:0",
     "equals": "(no subject)"
    }
   ]
  },
  {
   "op": "capture",
   "name": "no-subject-row"
  },
  {
   "op": "search",
   "text": "xi no from header"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800",
   "timeoutMs": 20800
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:cell:from:0",
     "equals": "(unknown)"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi no from header"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "no-from-open",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:detailTextHas:XI-NOFROM-BODY",
     "equals": "true"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800",
   "timeoutMs": 20800
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi no date header"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "no-date-open",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:detailTextHas:XI-NODATE-BODY",
     "equals": "true"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi future date"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "future-date-open",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:detailTextHas:XI-FUTURE-BODY",
     "equals": "true"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi empty body"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "empty-body-open",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedSubject",
     "equals": "xi empty body"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi dupid first"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:detailTextHas:XI-DUP-BODY-ONE",
     "equals": "true"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi dupid second"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "dup-message-id-second",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:detailTextHas:XI-DUP-BODY-TWO",
     "equals": "true"
    },
    {
     "model": "reading:detailTextHas:XI-DUP-BODY-ONE",
     "equals": "false"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}