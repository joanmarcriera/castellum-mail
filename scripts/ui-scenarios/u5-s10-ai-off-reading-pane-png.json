{ "schema": 1, "name": "u5-s10-ai-off-reading-pane-png",
  "covers": ["S10", "N/A", "Audit, PNG evidence only (SwiftUI buttons are not view-tree nodes): reading pane with AI on, then with AI off"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "ext", "id": "aiProbeFirstLaunch", "timeoutMs": 15000},
    {"op": "ext", "id": "waitExt", "name": "pref.aiEnabled", "text": "true", "timeoutMs": 15000},
    {"op": "ext", "id": "selectMailbox", "email": "alice@local.test", "text": "inbox"},
    {"op": "ext", "id": "selectMessage", "text": "Invoice R0012345678", "timeoutMs": 30000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-ai-on", "windows": ["main"]},
    {"op": "ext", "id": "setPref", "name": "aiEnabled", "text": "false"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "settle", "text": "1000"},
    {"op": "capture", "name": "02-ai-off", "windows": ["main"]},
    {"op": "assert", "expect": [{"model": "ext:pref.aiEnabled", "equals": "false"}]},
    {"op": "quit"} ] }
