{
 "schema": 1,
 "name": "xb-undo-send-reopen-resend",
 "covers": [
  "undo send",
  "Undo reopens the draft intact (nothing queued); sending it again delivers exactly once with the edit"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "5"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "cc",
   "text": "carol@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb undo {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "First version."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "undoBanner",
   "text": "shown",
   "timeoutMs": 15000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "banner",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:composeWindows",
     "equals": "0"
    },
    {
     "model": "ext:pendingCount",
     "equals": "1"
    }
   ]
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "main",
   "text": "cmd+z"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "undoBanner",
   "text": "hidden",
   "timeoutMs": 10000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "reopened"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:body",
     "equals": "First version."
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "subject",
   "text": "xb undo {run}",
   "timeoutMs": 10000
  },
  {
   "op": "ext",
   "id": "appendBody",
   "window": "@compose",
   "text": " Second version."
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "undoBanner",
   "text": "shown",
   "timeoutMs": 15000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "undoBanner",
   "text": "hidden",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1500"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-send",
   "windows": [
    "main"
   ]
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "bob@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb undo {run}",
   "timeoutMs": 120000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "capture",
   "name": "bob-got-it",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:src.has:First version. Second version.",
     "equals": "true"
    },
    {
     "model": "ext:src.has:carol@local.test",
     "equals": "true"
    }
   ]
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "messageCount:xb undo {run}",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "quit"
  }
 ]
}