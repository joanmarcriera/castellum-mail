{ "schema": 1, "name": "u1-s17-update-schedule",
  "covers": ["S17", "N/A", "Settings > General > Updates: Never / At launch / Daily picker and its caption"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 90000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [640, 700]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-default-daily"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "fitsScreen", "noClippedText"],
     "expect": [ {"model": "accounts:updateSchedule", "equals": "daily"},
                 {"find": {"role": "popup", "label": "Daily"}, "visible": true} ]},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "Daily"}, "text": "Never"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-never"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "accounts:updateSchedule", "equals": "never"} ]},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "Never"}, "text": "At launch"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-at-launch"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "accounts:updateSchedule", "equals": "atLaunch"} ]},
    {"op": "accounts", "id": "popupSelect", "window": "settings", "find": {"role": "popup", "label": "At launch"}, "text": "Daily"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "04-daily-again"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "accounts:updateSchedule", "equals": "daily"} ]},
    {"op": "quit"} ] }
