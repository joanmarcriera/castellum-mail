{
 "schema": 1,
 "name": "xc-defect-forgotten-attachment-ca-verb-missed",
 "covers": [
  "DEFECT: Catalan 'adjuntem' (we attach) with nothing attached must raise the forgotten-attachment warning"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xc-me@local.test",
   "password": "xc-me@local.test",
   "imap": "127.0.0.1:3143",
   "smtp": "127.0.0.1:3025",
   "tls": false,
   "as": "me",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xc-me@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "me",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC pressupost amb adjunt"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "Re: XC pressupost {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Bon dia, us adjuntem el contracte signat. {run}"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "2500"
  },
  {
   "op": "capture",
   "name": "ca-adjuntem"
  },
  {
   "op": "press",
   "window": "class:_NSAlertPanel",
   "find": {
    "label": "Cancel"
   }
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:composeWindows",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}