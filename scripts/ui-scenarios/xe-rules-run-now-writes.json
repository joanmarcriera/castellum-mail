{
 "schema": 1,
 "name": "xe-rules-run-now-writes",
 "covers": [
  "MM-3",
  "Run Now with writes enabled: counts, protected folders, match nothing / everything"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xe-r1@local.test",
   "password": "xe-r1@local.test",
   "as": "r1",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "setWrite",
   "accountRef": "r1",
   "value": true
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Nothing",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"nobody-xyz\"}], \"groups\": []}, \"actions\": [\"mark_read\"], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Everything",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"xe-\"}], \"groups\": []}, \"actions\": [{\"add_flag\": {}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Read news",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"xe-news\"}], \"groups\": []}, \"actions\": [\"mark_read\"], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "File invoices",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"subject\", \"operator\": \"contains\", \"value\": \"XE Invoice\"}], \"groups\": []}, \"actions\": [\"mark_read\", {\"move\": {\"mailbox_id\": \"xe-r1@local.test:Receipts\"}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Archive news",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"xe-news\"}], \"groups\": []}, \"actions\": [\"archive\"], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "previewRule",
   "name": "Nothing"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Nothing",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "0 matched, 0 actions queued."
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "previewRule",
   "name": "Read news"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "3"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Read news",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "3 matched, 3 actions queued."
    }
   ]
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 45000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "File invoices",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "2 matched, 4 actions queued."
    }
   ]
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 45000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Archive news",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "3 matched, 3 actions queued."
    }
   ]
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 45000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "r1",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "3"
    },
    {
     "model": "reading:hasSubject:XE Weekly",
     "equals": "false"
    },
    {
     "model": "reading:hasSubject:XE Invoice",
     "equals": "false"
    },
    {
     "model": "reading:hasSubject:XE Long",
     "equals": "true"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "capture",
   "name": "inbox-after-rules",
   "windows": [
    "main"
   ]
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "rules"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "rules-tab-writes-on",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:ruleCount",
     "equals": "5"
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank"
   ]
  },
  {
   "op": "quit"
  }
 ]
}