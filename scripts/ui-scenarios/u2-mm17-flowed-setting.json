{ "schema": 1, "name": "u2-mm17-flowed-setting",
  "covers": ["MM-17", "S2", "N/A", "Settings > General > Sending: 'Send plain text as format=flowed' exists, defaults on, survives reopening"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 90000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-default-on"},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "noClippedText"],
     "expect": [ {"model": "ext:pref.sendFlowed", "equals": "true"} ]},
    {"op": "ext", "id": "setToggle", "window": "settings", "text": "Send plain text as format=flowed", "value": false},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-off"},
    {"op": "assert", "expect": [ {"model": "ext:pref.sendFlowed", "equals": "false"} ]},
    {"op": "closeWindow", "window": "settings"},
    {"op": "openWindow", "target": "settings", "tab": "general"},
    {"op": "wait", "until": "window:settings"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-reopened-still-off"},
    {"op": "assert", "expect": [ {"model": "ext:pref.sendFlowed", "equals": "false"} ]},
    {"op": "ext", "id": "setToggle", "window": "settings", "text": "Send plain text as format=flowed", "value": true},
    {"op": "wait", "until": "idle"},
    {"op": "assert", "expect": [ {"model": "ext:pref.sendFlowed", "equals": "true"} ]},
    {"op": "quit"} ] }
