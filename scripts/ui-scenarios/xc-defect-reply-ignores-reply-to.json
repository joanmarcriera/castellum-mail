{
 "schema": 1,
 "name": "xc-defect-reply-ignores-reply-to",
 "covers": [
  "DEFECT: Reply must go to the Reply-To address (xc-list@), not the From address"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xc-me@local.test",
   "password": "xc-me@local.test",
   "imap": "127.0.0.1:3143",
   "smtp": "127.0.0.1:3025",
   "tls": false,
   "as": "me",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xc-me@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "me",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC replyto list"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "reply-compose"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "Re: XC replyto list {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Replying, as asked, to the list. {run}"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 15000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "addAccount",
   "as": "list",
   "waitFor": "synced",
   "timeoutMs": 90000,
   "email": "xc-list@local.test",
   "password": "xc-list@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "list",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "5000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "list-inbox",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:messageCount:Re: XC replyto list {run}",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}