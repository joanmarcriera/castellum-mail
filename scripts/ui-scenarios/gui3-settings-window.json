{
 "schema": 1,
 "name": "gui3-settings-window",
 "covers": [
  "GUI-3",
  "#2646"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 120000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "general-min"
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "resizable",
    "movable",
    "fitsScreen",
    "noClippedText",
    "controlsReachable"
   ]
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "accounts",
   "accountRef": "alice"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "accounts"
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "noClippedText",
    "noZeroSizeTextFields"
   ],
   "expect": [
    {
     "model": "accountSync:alice",
     "equals": "ok"
    },
    {
     "model": "accountCount",
     "equals": "1"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}