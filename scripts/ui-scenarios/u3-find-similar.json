{
 "schema": 1,
 "name": "u3-find-similar",
 "covers": [
  "find similar"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "Invoice R0012345678"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "findSimilar"
  },
  {
   "op": "wait",
   "until": "sheet:findSimilar"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "find-similar-sheet"
  },
  {
   "op": "assert",
   "window": "sheet:findSimilar",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ],
   "expect": [
    {
     "model": "reading:findSimilarShown",
     "equals": "true"
    }
   ]
  },
  {
   "op": "reading",
   "id": "dismissFindSimilar"
  },
  {
   "op": "wait",
   "until": "noSheet:findSimilar"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:findSimilarShown",
     "equals": "false"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
