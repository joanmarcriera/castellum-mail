{
 "schema": 1,
 "name": "u3-mm4-layouts",
 "covers": [
  "MM-4 layouts",
  "N/A"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "Invoice R0012345678"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:layout",
     "equals": "widescreen"
    }
   ]
  },
  {
   "op": "capture",
   "name": "widescreen"
  },
  {
   "op": "assert",
   "window": "main",
   "rules": [
    "nonBlank"
   ],
   "expect": [
    {
     "model": "reading:layout",
     "equals": "widescreen"
    },
    {
     "model": "reading:tableFound",
     "equals": "true"
    }
   ]
  },
  {
   "op": "command",
   "id": "layoutClassic"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "classic"
  },
  {
   "op": "assert",
   "window": "main",
   "rules": [
    "nonBlank"
   ],
   "expect": [
    {
     "model": "reading:layout",
     "equals": "classic"
    },
    {
     "model": "reading:tableFound",
     "equals": "true"
    }
   ]
  },
  {
   "op": "command",
   "id": "layoutWidescreen"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:layout",
     "equals": "widescreen"
    }
   ]
  },
  {
   "op": "command",
   "id": "layoutClassic"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-general-layout-picker",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank"
   ],
   "expect": [
    {
     "model": "reading:layout",
     "equals": "classic"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
