{
 "schema": 1,
 "name": "xk-palette-destructive-readonly",
 "covers": [
  "write safety",
  "palette archive/delete/mark-all on a read-only account never queues a write"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "Invoice R0012345678"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "remember"
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-with-selection"
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "class:SheetPresentationWindow",
   "text": "archive"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-archive"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "class:SheetPresentationWindow",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-archive"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0"
  },
  {
   "op": "assert",
   "label": "archive from the palette on a read-only account queued nothing and left the message",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "0"
    },
    {
     "model": "reading:rememberedInList",
     "equals": "true"
    }
   ]
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "class:SheetPresentationWindow",
   "text": "delete"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-delete"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "class:SheetPresentationWindow",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-delete"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0"
  },
  {
   "op": "assert",
   "label": "delete from the palette on a read-only account queued nothing and left the message",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "0"
    },
    {
     "model": "reading:rememberedInList",
     "equals": "true"
    }
   ]
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "class:SheetPresentationWindow",
   "text": "mark all"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-mark-all"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "class:SheetPresentationWindow",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-mark-all"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0"
  },
  {
   "op": "assert",
   "label": "mark all from the palette on a read-only account queued nothing and left the message",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "0"
    },
    {
     "model": "reading:rememberedInList",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 }
}