{
 "schema": 1,
 "name": "xj-defect-tags-vanish-on-mailbox-reload",
 "covers": [
  "S42 tags",
  "list_message_page never calls attach_keywords",
  "xj defect"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xj-org1@local.test",
   "password": "xj-org1@local.test",
   "as": "xj",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xj",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XJ Plain note"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "createTag",
   "name": "Feina",
   "text": "blue"
  },
  {
   "op": "reading",
   "id": "toggleTag",
   "text": "Feina"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "selectedKeywords",
   "text": "Feina",
   "timeoutMs": 15000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "600"
  },
  {
   "op": "capture",
   "name": "tagged-dot-visible"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedKeywords",
     "equals": "Feina"
    },
    {
     "model": "reading:tagDots:selected",
     "equals": "\u25cf"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xj",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XJ Plain note"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-reopening-the-inbox"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedKeywords",
     "equals": "Feina"
    },
    {
     "model": "reading:tagDots:selected",
     "equals": "\u25cf"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XJ Server keywords"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedKeywords",
     "equals": "xjServerTag"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}