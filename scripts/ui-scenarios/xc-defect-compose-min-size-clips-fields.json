{
 "schema": 1,
 "name": "xc-defect-compose-min-size-clips-fields",
 "covers": [
  "DEFECT: at its own minimum size the reply window must still show the To field and the Send buttons in full"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xc-me@local.test",
   "password": "xc-me@local.test",
   "imap": "127.0.0.1:3143",
   "smtp": "127.0.0.1:3025",
   "tls": false,
   "as": "me",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "me",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC plain note"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "title:Re: XC plain note",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "reply-at-min"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:composeWindows",
     "equals": "1"
    }
   ],
   "rules": [
    "fitsScreen",
    "controlsReachable",
    "primaryButtonsVisible"
   ],
   "window": "title:Re: XC plain note"
  },
  {
   "op": "quit"
  }
 ]
}