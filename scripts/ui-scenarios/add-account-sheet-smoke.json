{
 "schema": 1,
 "name": "add-account-sheet-smoke",
 "covers": [
  "GUI-1 (layout smoke)"
 ],
 "requires": {
  "greenmail": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 45000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded",
   "timeoutMs": 10000
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "default"
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "onScreen",
    "primaryButtonsVisible",
    "noZeroSizeTextFields",
    "noClippedText"
   ],
   "expect": [
    {
     "find": {
      "role": "button",
      "label": "Cancel"
     },
     "visible": true
    },
    {
     "find": {
      "identifier": "email"
     },
     "inVisibleRect": true
    },
    {
     "find": {
      "identifier": "smtpPassword"
     },
     "inVisibleRect": true
    },
    {
     "find": {
      "identifier": "initialHistory"
     },
     "inVisibleRect": true
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}