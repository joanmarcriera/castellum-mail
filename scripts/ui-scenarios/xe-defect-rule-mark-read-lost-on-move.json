{
 "schema": 1,
 "name": "xe-defect-rule-mark-read-lost-on-move",
 "covers": [
  "MM-3",
  "DEFECT: in a 'Mark as read + Move' rule the mark-read never reaches the server (replay finds the local row already deleted by the move and treats the op as moot)"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xe-r1@local.test",
   "password": "xe-r1@local.test",
   "as": "r1",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "setWrite",
   "accountRef": "r1",
   "value": true
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "File invoices",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"subject\", \"operator\": \"contains\", \"value\": \"XE Invoice\"}], \"groups\": []}, \"actions\": [\"mark_read\", {\"move\": {\"mailbox_id\": \"xe-r1@local.test:Filed\"}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Probe unread filed",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"subject\", \"operator\": \"contains\", \"value\": \"XE Invoice 100\"}, {\"field\": \"is_read\", \"operator\": \"is\", \"value\": false}], \"groups\": []}, \"actions\": [{\"add_flag\": {}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "previewRule",
   "name": "Probe unread filed"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "2"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "File invoices",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "2 matched, 4 actions queued."
    }
   ]
  },
  {
   "op": "reading",
   "id": "reSyncAll"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 45000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "r1",
   "text": "Filed"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "hasSubject:XE Invoice 1001",
   "text": "true",
   "timeoutMs": 45000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "filed-invoices-still-unread",
   "windows": [
    "main"
   ]
  },
  {
   "op": "reading",
   "id": "previewRule",
   "name": "Probe unread filed"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "0"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}