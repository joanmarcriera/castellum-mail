{
 "schema": 1,
 "name": "xc-defect-forgotten-attachment-subject-false-positive",
 "covers": [
  "DEFECT: a reply whose only 'attachment' word is in the inherited Re: subject must send without the forgotten-attachment warning"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xc-me@local.test",
   "password": "xc-me@local.test",
   "imap": "127.0.0.1:3143",
   "smtp": "127.0.0.1:3025",
   "tls": false,
   "as": "me",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xc-me@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "me",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC Attachment policy question"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "We have none, as far as I know."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "2500"
  },
  {
   "op": "capture",
   "name": "after-send"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:composeWindows",
     "equals": "0"
    }
   ]
  },
  {
   "op": "assert",
   "window": "main",
   "rules": [
    "noErrorAlert"
   ]
  },
  {
   "op": "quit"
  }
 ]
}