{
 "schema": 1,
 "name": "xd-find-similar-no-model",
 "covers": [
  "Find Similar without an embedding model"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "mailbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xd phrase one"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "findSimilar"
  },
  {
   "op": "wait",
   "until": "sheet:findSimilar"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "ai-off"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:findSimilarShown",
     "equals": "true"
    },
    {
     "model": "reading:findSimilarError",
     "equals": "Set an Ollama endpoint and model in Settings → AI first."
    }
   ],
   "window": "sheet:findSimilar",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "dismissFindSimilar"
  },
  {
   "op": "wait",
   "until": "noSheet:findSimilar"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:findSimilarShown",
     "equals": "false"
    },
    {
     "model": "reading:selectedSubject",
     "equals": "xd phrase one"
    }
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "10"
    },
    {
     "model": "reading:mailboxRole",
     "equals": "inbox"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}