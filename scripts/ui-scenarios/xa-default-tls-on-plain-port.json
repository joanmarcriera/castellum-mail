{
 "schema": 1,
 "name": "xa-default-tls-on-plain-port",
 "covers": [
  "Add sheet defaults (TLS on, SMTP 587) against a plain-text server: the failure names the TLS setting, nothing is saved"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "3143"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "accounts",
   "id": "waitNode",
   "window": "sheet:addAccount",
   "find": {
    "text": "check the port and TLS setting"
   },
   "value": true,
   "timeoutMs": 30000
  },
  {
   "op": "capture",
   "name": "01-tls-mismatch",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "rules": [
    "primaryButtonsVisible"
   ],
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "cancel"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    },
    {
     "model": "errorText",
     "equals": ""
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}