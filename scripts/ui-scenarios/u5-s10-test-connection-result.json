{ "schema": 1, "name": "u5-s10-test-connection-result",
  "covers": ["S10", "N/A", "Settings > AI: Test Connection shows green tick + model count against live Ollama, red cross + verbatim error against a dead port; result clears when the endpoint changes"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "ext", "id": "aiProbeFirstLaunch", "timeoutMs": 15000},
    {"op": "ext", "id": "waitExt", "name": "pref.aiEnabled", "text": "true", "timeoutMs": 15000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "ai"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "click", "window": "settings", "text": "151,352"},
    {"op": "accounts", "id": "settle", "text": "4000"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-live-green-tick", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank", "noClippedText"]},
    {"op": "ext", "id": "setPref", "name": "aiEndpoint", "text": "http://127.0.0.1:3999"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-result-cleared-after-endpoint-change", "windows": ["settings"]},
    {"op": "accounts", "id": "click", "window": "settings", "text": "151,352"},
    {"op": "accounts", "id": "settle", "text": "4000"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-dead-port-red-cross", "windows": ["settings"]},
    {"op": "assert", "window": "settings", "rules": ["nonBlank"], "expect": [{"model": "ext:pref.aiEndpoint", "equals": "http://127.0.0.1:3999"}]},
    {"op": "quit"} ] }
