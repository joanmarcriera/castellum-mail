{
 "schema": 1,
 "name": "xk-defect-palette-search-ignores-shown-label",
 "covers": [
  "S45 command palette",
  "search matches the text the row shows"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 60000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "showPalette"
  },
  {
   "op": "wait",
   "until": "sheet:palette"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "classic"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "typed-classic-row-does-not-say-classic"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "above"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "typed-above-no-match"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:palette",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "typing a word of the visible row label 'Message list above the reading pane' finds and runs it",
   "expect": [
    {
     "model": "reading:layout",
     "equals": "classic"
    },
    {
     "sheetAttached": false
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}