{ "schema": 1, "name": "u1-s20-duplicate-account",
  "covers": ["S20", "N/A", "Accounts: Duplicate...", "Add sheet: Copy settings from"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 150000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "settings", "tab": "accounts", "accountRef": "alice"},
    {"op": "wait", "until": "window:settings"},
    {"op": "resizeWindow", "window": "settings", "contentSize": [760, 560]},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "accounts-alice-selected"},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Duplicate…"}, "name": "sheet:duplicate"},
    {"op": "wait", "until": "sheet:duplicate"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "duplicate-sheet"},
    {"op": "assert", "window": "sheet:duplicate", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible", "noZeroSizeTextFields"],
     "expect": [
       {"model": "accounts:field:sheet:duplicate|#0", "equals": ""},
       {"model": "accounts:field:sheet:duplicate|#4", "equals": ""},
       {"model": "accounts:field:sheet:duplicate|#5", "equals": ""},
       {"model": "accounts:field:sheet:duplicate|#2", "equals": "127.0.0.1"},
       {"model": "accounts:field:sheet:duplicate|#3", "equals": "3143"},
       {"model": "accounts:field:sheet:duplicate|#6", "equals": "127.0.0.1"},
       {"model": "accounts:field:sheet:duplicate|#7", "equals": "3025"},
       {"model": "accounts:field:sheet:duplicate|#8", "equals": ""},
       {"model": "accounts:field:sheet:duplicate|#9", "equals": ""} ]},
    {"op": "press", "window": "sheet:duplicate", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:duplicate"},
    {"op": "assert", "expect": [
       {"model": "accounts:endpoint:alice", "equals": "127.0.0.1:3143"},
       {"model": "accountCount", "equals": "1"} ]},
    {"op": "accounts", "id": "pressExpect", "window": "settings", "find": {"label": "Add…"}, "name": "sheet:add"},
    {"op": "wait", "until": "sheet:add"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "add-sheet-before-copy"},
    {"op": "assert", "window": "sheet:add", "expect": [
       {"find": {"role": "popup", "label": "None"}, "visible": true},
       {"model": "accounts:field:sheet:add|#0", "equals": ""} ]},
    {"op": "accounts", "id": "popupSelect", "window": "sheet:add", "find": {"role": "popup", "label": "None"}, "text": "alice@local.test"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "add-sheet-after-copy"},
    {"op": "assert", "window": "sheet:add", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible"],
     "expect": [
       {"model": "accounts:field:sheet:add|#0", "equals": ""},
       {"model": "accounts:field:sheet:add|#4", "equals": ""},
       {"model": "accounts:field:sheet:add|#5", "equals": ""},
       {"model": "accounts:field:sheet:add|#2", "equals": "127.0.0.1"},
       {"model": "accounts:field:sheet:add|#3", "equals": "3143"},
       {"model": "accounts:field:sheet:add|#6", "equals": "127.0.0.1"},
       {"model": "accounts:field:sheet:add|#7", "equals": "3025"} ]},
    {"op": "press", "window": "sheet:add", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:add"},
    {"op": "assert", "expect": [
       {"model": "accounts:endpoint:alice", "equals": "127.0.0.1:3143"},
       {"model": "accountCount", "equals": "1"} ]},
    {"op": "quit"} ] }
