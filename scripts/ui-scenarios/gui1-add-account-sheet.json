{ "schema": 1, "name": "gui1-add-account-sheet", "covers": ["GUI-1"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 45000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded", "timeoutMs": 10000},
    {"op": "openSheet", "target": "addAccount"},
    {"op": "wait", "until": "sheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "default"},
    {"op": "assert", "window": "sheet:addAccount",
     "rules": ["nonBlank", "resizable", "movableSheet", "fitsScreen", "onScreen",
               "primaryButtonsVisible", "noZeroSizeTextFields", "noClippedText"]},
    {"op": "resizeWindow", "window": "sheet:addAccount", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "min-height"},
    {"op": "assert", "window": "sheet:addAccount",
     "rules": ["primaryButtonsVisible", "controlsReachable", "noClippedText"],
     "expect": [{"find": {"role": "button", "label": "Cancel"}, "visible": true}]},
    {"op": "quit"} ] }
