{
 "schema": 1,
 "name": "u3-s55-invite-card",
 "covers": [
  "S55",
  "N/A",
  "calendar invite card"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "carol",
   "as": "carol",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "carol",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "Invitation: Castellum 0.3.3 planning (with ICS)",
   "value": true
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "idle",
   "timeoutMs": 20000
  },
  {
   "op": "capture",
   "name": "invite-card"
  },
  {
   "op": "assert",
   "window": "main",
   "rules": [
    "nonBlank"
   ],
   "expect": [
    {
     "model": "reading:hasInvite",
     "equals": "true"
    },
    {
     "model": "reading:invite",
     "equals": "REQUEST|Castellum 0.3.3 planning|alice@local.test|2"
    },
    {
     "model": "reading:selectedSubject",
     "equals": "Invitation: Castellum 0.3.3 planning (with ICS)"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
