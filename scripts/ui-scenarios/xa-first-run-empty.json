{
 "schema": 1,
 "name": "xa-first-run-empty",
 "covers": [
  "First run, empty profile: main window, Settings > Accounts empty state, Status dashboard"
 ],
 "requires": {
  "greenmail": false,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 90000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-main-first-run",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "window": "main",
   "rules": [
    "nonBlank"
   ],
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    },
    {
     "model": "errorText",
     "equals": ""
    },
    {
     "sheetAttached": false
    },
    {
     "model": "reading:syncBanner",
     "equals": "none"
    }
   ]
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "accounts"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": [
    760,
    560
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-settings-accounts-empty",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "closeWindow",
   "window": "settings"
  },
  {
   "op": "openWindow",
   "target": "status"
  },
  {
   "op": "wait",
   "until": "window:status"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "03-status-empty",
   "windows": [
    "status"
   ]
  },
  {
   "op": "assert",
   "window": "status",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "noClippedText"
   ]
  },
  {
   "op": "closeWindow",
   "window": "status"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    },
    {
     "model": "errorText",
     "equals": ""
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}