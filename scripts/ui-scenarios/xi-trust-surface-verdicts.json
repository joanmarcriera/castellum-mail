{
 "schema": 1,
 "name": "xi-trust-surface-verdicts",
 "covers": [
  "S48 trust surface",
  "fail, pass and none verdicts when the authserv-id equals the IMAP host",
  "unmatched authserv-id reads none",
  "spoofed display name still shows the real address"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xi-tr1@local.test",
   "password": "xi-tr1@local.test",
   "as": "tr",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "addAccount",
   "email": "xi-r4@local.test",
   "password": "xi-r4@local.test",
   "as": "xi",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1270,
    720
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "tr",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi trust exact host fail"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "fail-badge",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:trust",
     "equals": "spf=fail dkim=fail dmarc=fail"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi trust exact host pass"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "pass-badge",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:trust",
     "equals": "spf=pass dkim=pass dmarc=pass"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi trust none"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "none-badge",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:trust",
     "equals": "spf=none dkim=none dmarc=none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xi",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi auth all pass"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:trust",
     "equals": "spf=none dkim=none dmarc=none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi auth all fail"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "foreign-authserv-fail-reads-none",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:trust",
     "equals": "spf=none dkim=none dmarc=none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xi spoofed display name"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "spoofed-display-name",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:trust",
     "equals": "spf=none dkim=none dmarc=none"
    },
    {
     "model": "reading:detailTextHas:XI-SPOOF-BODY",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}