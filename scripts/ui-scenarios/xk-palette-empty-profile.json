{
 "schema": 1,
 "name": "xk-palette-empty-profile",
 "covers": [
  "S45 command palette",
  "empty profile",
  "no match",
  "long query",
  "open twice",
  "Return runs command",
  "disabled row inert"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "showPalette"
  },
  {
   "op": "wait",
   "until": "sheet:palette"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-empty-profile"
  },
  {
   "op": "assert",
   "label": "palette",
   "expect": [],
   "window": "sheet:palette",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "palette twice = one sheet",
   "expect": [
    {
     "windowCount": 2
    },
    {
     "sheetAttached": true
    }
   ]
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "zzzzqqqq"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-no-match"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status status "
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-very-long-query"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-cleared"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "reply"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-reply-disabled"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:palette",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "Return on a disabled row (Reply, nothing selected) keeps the palette open",
   "expect": [
    {
     "sheetAttached": true
    },
    {
     "windowCount": 2
    }
   ]
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "classic"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-classic"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:palette",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "Return ran Classic Layout and closed the palette",
   "expect": [
    {
     "windowCount": 1
    },
    {
     "sheetAttached": false
    },
    {
     "model": "reading:layout",
     "equals": "classic"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "capture",
   "name": "after-classic"
  },
  {
   "op": "reading",
   "id": "showPalette"
  },
  {
   "op": "wait",
   "until": "sheet:palette"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "fieldText",
   "window": "sheet:palette",
   "text": "status"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:palette",
   "text": "100,20"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "400"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "status-from-palette"
  },
  {
   "op": "assert",
   "label": "Status opened from the palette",
   "expect": [
    {
     "windowCount": 2
    },
    {
     "sheetAttached": false
    }
   ],
   "window": "title:Status"
  },
  {
   "op": "quit"
  }
 ]
}