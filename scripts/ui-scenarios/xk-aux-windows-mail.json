  {
   "op": "assert",
   "label": "aiActivity",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "aiActivity",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "onScreen"
   ]
  },
  {
   "op": "closeWindow",
   "window": "aiActivity"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "all closed",
   "expect": [
    {
     "windowCount": 1
    },
    {
     "model": "reading:selectedSubject",
     "equals": "Invoice R0012345678 for August 2026"
    }
   ]
  },
  {
   "op": "quit"
  }
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 }
}