{ "schema": 1, "name": "u5-s10-ai-off-reading-pane",
  "covers": ["S10", "N/A", "Audit: with AI on the reading pane has Summarize and Reply with AI; with AI off both are gone (positive control first)"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "ext", "id": "aiProbeFirstLaunch", "timeoutMs": 15000},
    {"op": "ext", "id": "waitExt", "name": "pref.aiEnabled", "text": "true", "timeoutMs": 15000},
    {"op": "ext", "id": "selectMailbox", "email": "alice@local.test", "text": "inbox"},
    {"op": "ext", "id": "selectMessage", "text": "Invoice R0012345678", "timeoutMs": 30000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-ai-on", "windows": ["main"]},
    {"op": "accounts", "id": "waitNode", "window": "main", "find": {"text": "Reply with AI"}, "value": true, "timeoutMs": 5000},
    {"op": "accounts", "id": "waitNode", "window": "main", "find": {"text": "Summarize"}, "value": true, "timeoutMs": 5000},
    {"op": "ext", "id": "setPref", "name": "aiEnabled", "text": "false"},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "settle", "text": "1000"},
    {"op": "capture", "name": "02-ai-off", "windows": ["main"]},
    {"op": "accounts", "id": "waitNode", "window": "main", "find": {"text": "Reply with AI"}, "value": false, "timeoutMs": 5000},
    {"op": "accounts", "id": "waitNode", "window": "main", "find": {"text": "Summarize"}, "value": false, "timeoutMs": 5000},
    {"op": "quit"} ] }
