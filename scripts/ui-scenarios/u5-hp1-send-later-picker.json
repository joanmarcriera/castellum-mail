{ "schema": 1, "name": "u5-hp1-send-later-picker",
  "covers": ["HP1", "N/A", "Send Later control in compose opens the preset picker"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 150000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "reading", "id": "setWrite", "accountRef": "alice", "value": true},
    {"op": "openWindow", "target": "compose"},
    {"op": "wait", "until": "window:compose"},
    {"op": "wait", "until": "idle"},
    {"op": "ext", "id": "setField", "window": "compose", "name": "to", "text": "bob@local.test"},
    {"op": "ext", "id": "setField", "window": "compose", "name": "subject", "text": "HP1 picker"},
    {"op": "ext", "id": "setBody", "window": "compose", "text": "Send me later.\n"},
    {"op": "wait", "until": "idle"},
    {"op": "assert", "window": "compose", "expect": [ {"find": {"label": "Send Later"}, "enabled": true} ]},
    {"op": "press", "window": "compose", "find": {"label": "Send Later"}},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "picker-open"},
    {"op": "quit"} ] }
