{
 "schema": 1,
 "name": "u4-reader-body-html",
 "covers": [
  "UIT-1 reader-pane/WKWebView body capture",
  "S48 body half (sanitised HTML body renders)"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "This Week in Rust #612"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "reader-body",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:selectedSubject",
     "equals": "This Week in Rust #612"
    },
    {
     "model": "reading:webBodyHas:This Week in Rust",
     "equals": "true"
    },
    {
     "model": "reading:webBodyHas:rustls 0.24",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}
