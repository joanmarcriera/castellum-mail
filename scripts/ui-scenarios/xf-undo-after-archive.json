{
 "schema": 1,
 "name": "xf-undo-after-archive",
 "covers": [
  "undo",
  "archive",
  "Cmd-Z"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xf-u@local.test",
   "password": "xf-u@local.test",
   "as": "u",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xf-u@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "u",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XF u msg 3"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "command",
   "id": "archive",
   "allowServerWrites": true
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "800"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "4"
    },
    {
     "model": "reading:undoDepth",
     "equals": "1"
    }
   ],
   "label": "archived: the row left and an undo entry exists"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:editUndo",
     "equals": "Undo|true|window|winCanUndo=true|winUndo=Undo Archive"
    }
   ],
   "label": "the window's UndoManager holds 'Undo Archive' (what Edit > Undo runs)"
  },
  {
   "op": "command",
   "id": "undoRemoval",
   "allowServerWrites": true,
   "label": "undo the archive (menu command / bare z route)"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "2500"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 40000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "accounts",
   "id": "settle",
   "text": "1500"
  },
  {
   "op": "capture",
   "name": "after-undo"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "5"
    },
    {
     "model": "reading:hasSubject:XF u msg 3",
     "equals": "true"
    },
    {
     "model": "reading:undoDepth",
     "equals": "0"
    }
   ],
   "label": "Undo after Archive brings the message back to the Inbox"
  },
  {
   "op": "quit"
  }
 ]
}