{
 "schema": 1,
 "name": "xa-unreachable-then-cancel",
 "covers": [
  "Unreachable port and unknown host in the Add sheet: human-readable inline errors per leg, then Cancel leaves no account, no status dot, no banner, no alert"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "3999"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "7",
   "text": "3025"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,270"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,442"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "accounts",
   "id": "waitNode",
   "window": "sheet:addAccount",
   "find": {
    "text": "Can\u2019t reach 127.0.0.1:3999 (IMAP)"
   },
   "value": true,
   "timeoutMs": 20000
  },
  {
   "op": "capture",
   "name": "01-unreachable-port",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "no-such-host.invalid"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "3143"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "accounts",
   "id": "waitNode",
   "window": "sheet:addAccount",
   "find": {
    "text": "Can\u2019t reach no-such-host.invalid:3143 (IMAP)"
   },
   "value": true,
   "timeoutMs": 30000
  },
  {
   "op": "capture",
   "name": "02-unknown-host",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "abc"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    },
    {
     "find": {
      "identifier": "testConnection"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "cancel"
   }
  },
  {
   "op": "wait",
   "until": "noSheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "03-main-after-cancel",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "0"
    },
    {
     "model": "reading:syncBanner",
     "equals": "none"
    },
    {
     "model": "accounts:dotState:xa-one@local.test",
     "equals": "none"
    },
    {
     "model": "errorText",
     "equals": ""
    }
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "sheetAttached": false
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}