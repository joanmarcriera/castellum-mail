{
 "schema": 1,
 "name": "u2-s2-ai-cancel-on-close",
 "covers": ["S2", "AI polish: cancel a job on window close (#427)", "N/A"],
 "requires": {"greenmail": true, "personas": true},
 "screen": {"width": 1280, "height": 768, "menuBar": 25},
 "timeoutMs": 240000,
 "steps": [
  {"op": "wait", "until": "accountsLoaded"},
  {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 60000},
  {"op": "ext", "id": "aiProbeFirstLaunch", "timeoutMs": 15000},
  {"op": "ext", "id": "waitExt", "name": "pref.aiEnabled", "text": "true", "timeoutMs": 15000},
  {"op": "ext", "id": "aiUseFirstModel", "text": "llama3.1:8b|qwen2.5:7b|largest"},
  {"op": "ext", "id": "selectMailbox", "email": "alice@local.test", "text": "inbox"},
  {"op": "ext", "id": "selectMessage", "text": "Invoice R0012345678", "timeoutMs": 30000},
  {"op": "wait", "until": "idle"},

  {"op": "command", "id": "replyWithAi"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "1", "timeoutMs": 10000},
  {"op": "ext", "id": "waitAiJob", "name": "draft_reply", "text": "any", "timeoutMs": 20000},
  {"op": "capture", "name": "reply-draft-streaming"},
  {"op": "ext", "id": "closeCompose"},
  {"op": "ext", "id": "waitExt", "name": "composeWindows", "text": "0", "timeoutMs": 10000},
  {"op": "ext", "id": "waitExt", "name": "aiJob.draft_reply", "text": "cancelled", "timeoutMs": 10000},
  {"op": "openWindow", "target": "aiActivity"},
  {"op": "wait", "until": "window:aiActivity"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "activity-after-reply-close"},
  {"op": "assert", "expect": [
    {"model": "ext:aiJob.draft_reply", "equals": "cancelled"},
    {"model": "ext:aiRunning:draft_reply", "equals": "0"}
  ]},
  {"op": "closeWindow", "window": "aiActivity"},

  {"op": "ext", "id": "selectMessage", "text": "Invoice R0012345678", "timeoutMs": 10000},
  {"op": "command", "id": "summarize"},
  {"op": "ext", "id": "waitAiJob", "name": "summarize_message", "text": "any", "timeoutMs": 20000},
  {"op": "ext", "id": "selectMessage", "text": "This Week in Rust", "timeoutMs": 10000},
  {"op": "ext", "id": "waitExt", "name": "aiJob.summarize_message", "text": "cancelled", "timeoutMs": 10000},
  {"op": "openWindow", "target": "aiActivity"},
  {"op": "wait", "until": "idle"},
  {"op": "capture", "name": "activity-after-navigating-away"},
  {"op": "assert", "expect": [
    {"model": "ext:aiRunning:summarize_message", "equals": "0"},
    {"model": "ext:aiRunning:draft_reply", "equals": "0"}
  ]},
  {"op": "quit"}
 ]
}
