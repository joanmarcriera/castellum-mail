{
 "schema": 1,
 "name": "xe-rules-eval-mode-refused",
 "covers": [
  "MM-3",
  "evaluation mode: every rule action refused, nothing queued"
 ],
 "requires": {
  "greenmail": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xe-r1@local.test",
   "password": "xe-r1@local.test",
   "as": "r1",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Read news",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"xe-news\"}], \"groups\": []}, \"actions\": [\"mark_read\"], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Star invoices",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"subject\", \"operator\": \"contains\", \"value\": \"XE Invoice\"}], \"groups\": []}, \"actions\": [{\"add_flag\": {}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Archive news",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"xe-news\"}], \"groups\": []}, \"actions\": [\"archive\"], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "Trash list",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"from\", \"operator\": \"contains\", \"value\": \"xe-list\"}], \"groups\": []}, \"actions\": [\"trash\"], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "saveRule",
   "name": "File invoices",
   "text": "{\"group\": {\"op\": \"and\", \"conditions\": [{\"field\": \"subject\", \"operator\": \"contains\", \"value\": \"XE Invoice\"}], \"groups\": []}, \"actions\": [\"mark_read\", {\"move\": {\"mailbox_id\": \"xe-r1@local.test:Receipts\"}}], \"stop\": false, \"account\": \"r1\"}"
  },
  {
   "op": "reading",
   "id": "previewRule",
   "name": "Read news"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "3"
    }
   ]
  },
  {
   "op": "reading",
   "id": "previewRule",
   "name": "Star invoices"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:note",
     "equals": "2"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Read news",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:noteHas:evaluation mode",
     "equals": "true"
    },
    {
     "model": "reading:noteHas:3 matched, 0 actions queued",
     "equals": "true"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Star invoices",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:noteHas:evaluation mode",
     "equals": "true"
    },
    {
     "model": "reading:noteHas:2 matched, 0 actions queued",
     "equals": "true"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Archive news",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:noteHas:evaluation mode",
     "equals": "true"
    },
    {
     "model": "reading:noteHas:3 matched, 0 actions queued",
     "equals": "true"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "Trash list",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:noteHas:evaluation mode",
     "equals": "true"
    },
    {
     "model": "reading:noteHas:0 actions queued",
     "equals": "true"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "runRule",
   "name": "File invoices",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:noteHas:evaluation mode",
     "equals": "true"
    },
    {
     "model": "reading:noteHas:2 matched, 0 actions queued",
     "equals": "true"
    },
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "r1",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:messageCount",
     "equals": "8"
    },
    {
     "model": "reading:errorText",
     "equals": "none"
    }
   ]
  },
  {
   "op": "capture",
   "name": "inbox-untouched",
   "windows": [
    "main"
   ]
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "rules"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "rules-tab-read-only",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:ruleCount",
     "equals": "5"
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "quit"
  }
 ]
}