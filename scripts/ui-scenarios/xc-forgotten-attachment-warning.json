{
 "schema": 1,
 "name": "xc-forgotten-attachment-warning",
 "covers": [
  "HP5a forgotten-attachment warning: en/es/ca keyword, Cancel keeps the draft, quoted keyword ignored, Send Anyway sends"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xc-me@local.test",
   "password": "xc-me@local.test",
   "imap": "127.0.0.1:3143",
   "smtp": "127.0.0.1:3025",
   "tls": false,
   "as": "me",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "xc-me@local.test"
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "me",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC plain note"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "Re: XC plain note warn {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Please find attached the agenda."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "capture",
   "name": "warn-en"
  },
  {
   "op": "press",
   "window": "class:_NSAlertPanel",
   "find": {
    "label": "Cancel"
   }
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800"
  },
  {
   "op": "assert",
   "expect": [
    {
     "windowCount": 2
    },
    {
     "model": "ext:composeWindows",
     "equals": "1"
    }
   ]
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Hola, adjunto la factura de marzo."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "capture",
   "name": "warn-es"
  },
  {
   "op": "press",
   "window": "class:_NSAlertPanel",
   "find": {
    "label": "Cancel"
   }
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800"
  },
  {
   "op": "assert",
   "expect": [
    {
     "windowCount": 2
    },
    {
     "model": "ext:composeWindows",
     "equals": "1"
    }
   ]
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Bon dia, t'adjunto el pressupost revisat."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "capture",
   "name": "warn-ca"
  },
  {
   "op": "press",
   "window": "class:_NSAlertPanel",
   "find": {
    "label": "Cancel"
   }
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800"
  },
  {
   "op": "assert",
   "expect": [
    {
     "windowCount": 2
    },
    {
     "model": "ext:composeWindows",
     "equals": "1"
    }
   ]
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Thanks, that works.\n\nOn 5 Oct 2026 at 13:48, Anna Puig wrote:\n> Please see the attached file for details.\n> Adjunto la factura."
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 15000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:composeWindows",
     "equals": "0"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "XC plain note"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "command",
   "id": "reply"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "Re: XC plain note anyway {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "See attached. {run}"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "press",
   "window": "class:_NSAlertPanel",
   "find": {
    "label": "Send Anyway"
   }
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "800"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 15000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-send-anyway",
   "windows": [
    "main"
   ]
  },
  {
   "op": "quit"
  }
 ]
}