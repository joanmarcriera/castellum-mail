{
 "schema": 1,
 "name": "xa-add-first-account-sheet",
 "covers": [
  "First account through the real Add sheet (TLS off, GreenMail): Sync enabled only when filled, sheet closes by itself, account is synced, stored endpoint is right, no error alert"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "01-blank-sheet",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "rules": [
    "nonBlank",
    "fitsScreen",
    "primaryButtonsVisible",
    "noClippedText",
    "noZeroSizeTextFields"
   ],
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    },
    {
     "find": {
      "identifier": "testConnection"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": false
    }
   ]
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "3143"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "7",
   "text": "3025"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,270"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,442"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "02-filled",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "expect": [
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": true
    }
   ]
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "wait",
   "until": "sync:xa-one@local.test=ok",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "noSheet:addAccount",
   "timeoutMs": 15000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "03-main-after",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "1"
    },
    {
     "model": "accounts:dotState:xa-one@local.test",
     "equals": "ok"
    },
    {
     "model": "accounts:endpoint:xa-one@local.test",
     "equals": "127.0.0.1:3143"
    },
    {
     "model": "accounts:sidebarLabel:xa-one@local.test",
     "equals": "xa-one@local.test"
    },
    {
     "model": "errorText",
     "equals": ""
    },
    {
     "model": "reading:syncBanner",
     "equals": "none"
    }
   ]
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xa-one@local.test",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "04-inbox-selected",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasMessages",
     "equals": "true"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}