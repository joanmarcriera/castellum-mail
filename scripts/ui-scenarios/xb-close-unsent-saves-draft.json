{
 "schema": 1,
 "name": "xb-close-unsent-saves-draft",
 "covers": [
  "drafts",
  "closing a window with unsent text keeps one draft; reopened and sent, it carries the To, Cc, Bcc, subject and body that were typed"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "bob@local.test, Carol Vidal <carol@local.test>"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "cc",
   "text": "\"Soler, Dave\" <dave@local.test>"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "bcc",
   "text": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb unsent {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Line one.\n\nLine three with àccents 🙂."
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "300"
  },
  {
   "op": "capture",
   "name": "typed"
  },
  {
   "op": "ext",
   "id": "closeCompose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 10000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1000"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "drafts:alice@local.test",
   "text": "xb unsent {run}",
   "timeoutMs": 10000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:pendingCount",
     "equals": "0"
    }
   ]
  },
  {
   "op": "ext",
   "id": "openFirstDraft",
   "email": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "reopened"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:body",
     "equals": "Line one.\n\nLine three with àccents 🙂."
    }
   ]
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "subject",
   "text": "xb unsent {run}",
   "timeoutMs": 10000
  },
  {
   "op": "ext",
   "id": "closeCompose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 10000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1000"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "drafts:alice@local.test",
   "text": "xb unsent {run}",
   "timeoutMs": 10000
  },
  {
   "op": "ext",
   "id": "openFirstDraft",
   "email": "alice@local.test"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "addAccount",
   "persona": "dave",
   "as": "dave",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "dave@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb unsent {run}",
   "timeoutMs": 120000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1000"
  },
  {
   "op": "capture",
   "name": "dave-reads",
   "windows": [
    "main"
   ]
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:src.has:\"Carol Vidal\" <carol@local.test>",
     "equals": "true"
    },
    {
     "model": "ext:src.has:bob@local.test",
     "equals": "true"
    },
    {
     "model": "ext:src.has:Bcc:",
     "equals": "false"
    },
    {
     "model": "ext:src.has:Line three with",
     "equals": "true"
    }
   ]
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "alice@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb unsent {run}",
   "timeoutMs": 120000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "alice-bcc-copy",
   "windows": [
    "main"
   ]
  },
  {
   "op": "quit"
  }
 ]
}