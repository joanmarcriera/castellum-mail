  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-licence-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "label": "settings licence at min",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-general-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "label": "settings general at min",
   "expect": [
