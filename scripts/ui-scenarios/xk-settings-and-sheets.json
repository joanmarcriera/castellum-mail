  },
  {
   "op": "command",
   "id": "showShortcuts"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "500"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "cheat-sheet"
  },
  {
   "op": "assert",
   "label": "cheat sheet",
   "expect": [
    {
     "sheetAttached": true
    }
   ],
   "window": "class:SheetPresentationWindow",
   "rules": [
    "fitsScreen"
   ]
  },
  {
   "op": "command",
   "id": "showCommandPalette"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "500"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "palette-requested-over-cheat-sheet"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "class:SheetPresentationWindow",
   "text": "572,536"
  },
  {
   "op": "ext",
   "id": "pause",
   "text": "1200"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "after-done"
  },
  {
   "op": "quit"
  }
 ]
}