{
 "schema": 1,
 "name": "xk-settings-and-sheets",
 "covers": [
  "settings window twice and at min per tab",
  "cheat sheet",
  "second sheet requested while one is up"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 120000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "wait",
   "until": "settingsOpenerReady"
  },
  {
   "op": "openWindow",
   "target": "settings",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "window:settings"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-general",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "label": "settings",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank",
    "resizable",
    "movable",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "general"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "Settings twice: one window",
   "expect": [
    {
     "windowCount": 2
    }
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "rules"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-rules-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "label": "settings rules at min",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "tags"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-tags-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "label": "settings tags at min",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "ai"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-ai-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
