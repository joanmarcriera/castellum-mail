    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "accounts"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "resizeWindow",
   "window": "settings",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "settings-accounts-min",
   "windows": [
    "settings"
   ]
  },
  {
   "op": "assert",
   "label": "settings accounts at min",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "settings",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "reading",
   "id": "settingsTab",
   "tab": "licence"
  },
  {
   "op": "wait",
