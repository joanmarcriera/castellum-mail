{ "schema": 1, "name": "u5-s13-retry-idle-failed-row",
  "covers": ["S13", "N/A", "Status row Retry on an idle failed row re-syncs; recovery is faster than the periodic loop"],
  "requires": {"greenmail": true, "personas": true}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 200000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "addAccount", "persona": "alice", "as": "alice", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "addAccount", "persona": "bob", "as": "bob", "waitFor": "synced", "timeoutMs": 90000},
    {"op": "wait", "until": "settingsOpenerReady"},
    {"op": "openWindow", "target": "status"},
    {"op": "wait", "until": "window:status"},
    {"op": "resizeWindow", "window": "status", "contentSize": [620, 460]},
    {"op": "accounts", "id": "setEndpoint", "accountRef": "bob", "text": "127.0.0.1:3999"},
    {"op": "wait", "until": "sync:bob=failed", "timeoutMs": 60000},
    {"op": "wait", "until": "idle"},
    {"op": "accounts", "id": "waitNode", "window": "status", "find": {"identifier": "statusRow", "text": ": syncing"}, "value": false, "timeoutMs": 10000},
    {"op": "accounts", "id": "waitNode", "window": "status", "find": {"identifier": "retry", "text": "Retry sync for bob@local.test"}, "value": true, "timeoutMs": 10000},
    {"op": "capture", "name": "01-idle-failed-row-with-retry"},
    {"op": "assert", "window": "status", "rules": ["nonBlank", "noClippedText"], "expect": [
       {"model": "accounts:dotState:bob", "equals": "unreachable"},
       {"find": {"identifier": "retry", "text": "Retry sync for bob@local.test"}, "exists": true, "enabled": true} ]},
    {"op": "accounts", "id": "setEndpoint", "accountRef": "bob", "text": "127.0.0.1:3143", "value": false},
    {"op": "wait", "until": "idle"},
    {"op": "assert", "expect": [ {"model": "accounts:dotState:bob", "equals": "unreachable"} ]},
    {"op": "accounts", "id": "pressExpect", "window": "status", "find": {"identifier": "retry", "text": "Retry sync for bob@local.test"}, "name": "none"},
    {"op": "wait", "until": "sync:bob=ok", "timeoutMs": 25000},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "02-recovered-by-retry-click"},
    {"op": "assert", "window": "status", "rules": ["nonBlank"], "expect": [
       {"model": "accounts:dotState:bob", "equals": "ok"} ]},
    {"op": "quit"} ] }
