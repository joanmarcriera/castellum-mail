{
 "schema": 1,
 "name": "xb-second-account-send",
 "covers": [
  "compose",
  "From picker: sending from the second account uses that account, its signature and its write policy"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 300000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "undoSendDelay",
   "text": "0"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "alice@local.test"
  },
  {
   "op": "addAccount",
   "persona": "bob",
   "as": "bob",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "enableWrites",
   "email": "bob@local.test"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "signature:alice@local.test",
   "text": "-- \nAlice sig"
  },
  {
   "op": "ext",
   "id": "setPref",
   "name": "signature:bob@local.test",
   "text": "-- \nBob sig"
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "alice@local.test",
   "text": "inbox"
  },
  {
   "op": "openWindow",
   "target": "compose"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "1",
   "timeoutMs": 10000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "new-from-alice"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:fromPopup",
     "equals": "alice@local.test"
    },
    {
     "model": "ext:bodyHas:Alice sig",
     "equals": "true"
    }
   ]
  },
  {
   "op": "ext",
   "id": "setPopup",
   "window": "@compose",
   "find": {
    "role": "popup",
    "label": "alice@local.test"
   },
   "text": "bob@local.test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:fromPopup",
     "equals": "bob@local.test"
    },
    {
     "model": "ext:bodyHas:Bob sig",
     "equals": "true"
    },
    {
     "model": "ext:bodyHas:Alice sig",
     "equals": "false"
    }
   ]
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "to",
   "text": "carol@local.test"
  },
  {
   "op": "ext",
   "id": "setField",
   "window": "@compose",
   "name": "subject",
   "text": "xb from bob {run}"
  },
  {
   "op": "ext",
   "id": "setBody",
   "window": "@compose",
   "text": "Sent from the second account.\n\n-- \nBob sig"
  },
  {
   "op": "capture",
   "name": "from-bob"
  },
  {
   "op": "ext",
   "id": "keyEquivalent",
   "window": "@compose",
   "text": "cmd+return"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "composeWindows",
   "text": "0",
   "timeoutMs": 20000
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "pendingCount",
   "text": "0",
   "timeoutMs": 30000
  },
  {
   "op": "addAccount",
   "persona": "carol",
   "as": "carol",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "carol@local.test",
   "text": "inbox"
  },
  {
   "op": "ext",
   "id": "selectMessage",
   "text": "=xb from bob {run}",
   "timeoutMs": 120000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "carol-inbox",
   "windows": [
    "main"
   ]
  },
  {
   "op": "ext",
   "id": "loadSource",
   "timeoutMs": 30000
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "ext:src.has:From: bob@local.test",
     "equals": "true"
    },
    {
     "model": "ext:src.has:alice@local.test",
     "equals": "false"
    }
   ]
  },
  {
   "op": "ext",
   "id": "selectMailbox",
   "email": "bob@local.test",
   "text": "sent"
  },
  {
   "op": "ext",
   "id": "waitExt",
   "name": "messageCount:xb from bob {run}",
   "text": "1",
   "timeoutMs": 120000
  },
  {
   "op": "capture",
   "name": "bob-sent",
   "windows": [
    "main"
   ]
  },
  {
   "op": "quit"
  }
 ]
}