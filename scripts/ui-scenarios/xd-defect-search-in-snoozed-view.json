{
 "schema": 1,
 "name": "xd-defect-search-in-snoozed-view",
 "covers": [
  "search",
  "Snoozed",
  "clearing the search"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 240000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "email": "xd-s1@local.test",
   "password": "xd-s1@local.test",
   "as": "xd",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "xd",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "mailbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "xd cc test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "remember"
  },
  {
   "op": "reading",
   "id": "snooze",
   "text": "3600"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "rememberedInList",
   "text": "false",
   "timeoutMs": 15000
  },
  {
   "op": "reading",
   "id": "selectSnoozed"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:isSnoozedList",
     "equals": "true"
    },
    {
     "model": "reading:hasSubject:xd cc test",
     "equals": "true"
    },
    {
     "model": "reading:messageCount",
     "equals": "1"
    }
   ]
  },
  {
   "op": "search",
   "text": "quick"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "search-from-snoozed-finds-nothing"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:xd phrase one",
     "equals": "true"
    }
   ]
  },
  {
   "op": "reading",
   "id": "searchScope",
   "text": "all"
  },
  {
   "op": "search",
   "text": "zebra"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:hasSubject:Re: \"Budget\" v2: final",
     "equals": "true"
    }
   ]
  },
  {
   "op": "search",
   "text": ""
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "cleared-search-still-shows-results-in-snoozed"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:searchText",
     "equals": ""
    },
    {
     "model": "reading:isSnoozedList",
     "equals": "true"
    },
    {
     "model": "reading:hasSubject:xd cc test",
     "equals": "true"
    },
    {
     "model": "reading:hasSubject:Re: \"Budget\" v2: final",
     "equals": "false"
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}