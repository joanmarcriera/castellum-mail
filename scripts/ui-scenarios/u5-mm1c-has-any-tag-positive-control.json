{
 "schema": 1,
 "name": "u5-mm1c-has-any-tag-positive-control",
 "covers": [
  "MM1c",
  "N/A"
 ],
 "requires": {
  "greenmail": true,
  "personas": true
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "addAccount",
   "persona": "alice",
   "as": "alice",
   "waitFor": "synced",
   "timeoutMs": 90000
  },
  {
   "op": "reading",
   "id": "selectMailbox",
   "accountRef": "alice",
   "text": "inbox"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "Invoice R0012345678"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "toggleTag",
   "text": "$Forwarded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "selectedKeywords",
   "text": "$Forwarded",
   "timeoutMs": 15000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "selectMessage",
   "text": "This Week in Rust #612"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "createTag",
   "name": "Work",
   "text": "blue"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "toggleTag",
   "text": "Work"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "reading",
   "id": "waitFor",
   "name": "selectedKeywords",
   "text": "Work",
   "timeoutMs": 15000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:tagNames",
     "equals": "Work"
    }
   ]
  },
  {
   "op": "reading",
   "id": "upsertSmart",
   "name": "Has any tag",
   "accountRef": "alice",
   "text": "{\"op\": \"and\", \"conditions\": [{\"field\": \"tag\", \"operator\": \"is\", \"value\": true}], \"groups\": []}"
  },
  {
   "op": "reading",
   "id": "selectSmart",
   "text": "Has any tag"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "reading:smartSelected",
     "equals": "Has any tag"
    },
    {
     "model": "reading:messageCount",
     "equals": "1"
    },
    {
     "model": "reading:hasSubject:This Week in Rust #612",
     "equals": "true"
    },
    {
     "model": "reading:hasSubject:Invoice R0012345678",
     "equals": "false"
    }
   ]
  },
  {
   "op": "capture",
   "name": "has-any-tag-positive-control"
  }
 ]
}