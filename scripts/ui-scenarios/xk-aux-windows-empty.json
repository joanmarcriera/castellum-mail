{
 "schema": 1,
 "name": "xk-aux-windows-empty",
 "covers": [
  "aux windows empty state",
  "open twice",
  "min and large size",
  "close"
 ],
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "main-empty"
  },
  {
   "op": "openWindow",
   "target": "status"
  },
  {
   "op": "wait",
   "until": "window:status"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "status-default",
   "windows": [
    "status"
   ]
  },
  {
   "op": "assert",
   "label": "status default",
   "expect": [
    {
     "windowCount": 2
    }
   ],
   "window": "status",
   "rules": [
    "nonBlank",
    "resizable",
    "movable",
    "fitsScreen",
    "onScreen"
   ]
  },
  {
   "op": "command",
   "id": "showStatus"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "status opened twice stays one window",
   "expect": [
    {
     "windowCount": 2
    }
   ]
  },
  {
   "op": "resizeWindow",
   "window": "status",
   "contentSize": "min"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "status-min",
   "windows": [
    "status"
   ]
  },
  {
   "op": "assert",
   "label": "status min",
   "expect": [],
   "window": "status",
   "rules": [
    "nonBlank",
    "fitsScreen"
   ]
  },
  {
   "op": "resizeWindow",
   "window": "status",
   "contentSize": [
    1240,
    700
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "capture",
   "name": "status-large",
   "windows": [
    "status"
   ]
  },
  {
   "op": "assert",
   "label": "status large",
   "expect": [],
   "window": "status",
   "rules": [
    "nonBlank"
   ]
  },
  {
   "op": "closeWindow",
   "window": "status"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "label": "status closed",
   "expect": [
    {
     "windowCount": 1
    }
   ]
  },
