{
 "schema": 1,
 "name": "xa-wrong-password-then-fix",
 "covers": [
  "Wrong password in the Add sheet: inline sign-in failure, nothing saved, fields kept; correcting the password and pressing Sync again adds the account"
 ],
 "requires": {
  "greenmail": true,
  "personas": false
 },
 "screen": {
  "width": 1280,
  "height": 768,
  "menuBar": 25
 },
 "timeoutMs": 180000,
 "steps": [
  {
   "op": "wait",
   "until": "accountsLoaded"
  },
  {
   "op": "resizeWindow",
   "window": "main",
   "contentSize": [
    1200,
    690
   ]
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "openSheet",
   "target": "addAccount"
  },
  {
   "op": "wait",
   "until": "sheet:addAccount"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "email"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "imapHost"
   },
   "text": "127.0.0.1"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "3",
   "text": "3143"
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "definitely-wrong"
  },
  {
   "op": "accounts",
   "id": "setNth",
   "window": "sheet:addAccount",
   "name": "7",
   "text": "3025"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,270"
  },
  {
   "op": "accounts",
   "id": "click",
   "window": "sheet:addAccount",
   "text": "179,442"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "accounts",
   "id": "waitNode",
   "window": "sheet:addAccount",
   "find": {
    "text": "IMAP sign-in to 127.0.0.1:3143 failed"
   },
   "value": true,
   "timeoutMs": 20000
  },
  {
   "op": "capture",
   "name": "01-wrong-password",
   "windows": [
    "sheet:addAccount"
   ]
  },
  {
   "op": "assert",
   "window": "sheet:addAccount",
   "rules": [
    "primaryButtonsVisible"
   ],
   "expect": [
    {
     "find": {
      "identifier": "cancel"
     },
     "visible": true
    },
    {
     "find": {
      "identifier": "sync"
     },
     "enabled": true
    },
    {
     "model": "accountCount",
     "equals": "0"
    },
    {
     "model": "accounts:field:sheet:addAccount|#0",
     "equals": "xa-one@local.test"
    },
    {
     "model": "accounts:field:sheet:addAccount|#2",
     "equals": "127.0.0.1"
    }
   ]
  },
  {
   "op": "setText",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "password"
   },
   "text": "xa-one@local.test"
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "press",
   "window": "sheet:addAccount",
   "find": {
    "identifier": "sync"
   }
  },
  {
   "op": "wait",
   "until": "sync:xa-one@local.test=ok",
   "timeoutMs": 60000
  },
  {
   "op": "wait",
   "until": "noSheet:addAccount",
   "timeoutMs": 15000
  },
  {
   "op": "wait",
   "until": "idle"
  },
  {
   "op": "assert",
   "expect": [
    {
     "model": "accountCount",
     "equals": "1"
    },
    {
     "model": "errorText",
     "equals": ""
    }
   ]
  },
  {
   "op": "quit"
  }
 ]
}