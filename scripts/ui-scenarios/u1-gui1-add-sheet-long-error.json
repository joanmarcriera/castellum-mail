{ "schema": 1, "name": "u1-gui1-add-sheet-long-error",
  "covers": ["GUI-1", "N/A", "Add-account sheet: bad host + Test Connection, long error, buttons stay on screen"],
  "requires": {"greenmail": false}, "screen": {"width": 1280, "height": 768, "menuBar": 25},
  "timeoutMs": 120000,
  "steps": [
    {"op": "wait", "until": "accountsLoaded"},
    {"op": "openSheet", "target": "addAccount"},
    {"op": "wait", "until": "sheet:addAccount"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "01-default-height"},
    {"op": "assert", "window": "sheet:addAccount", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible", "noClippedText", "movableSheet", "resizable"]},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "email"}, "text": "someone@no-such-host.invalid"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "imapHost"}, "text": "no-such-host.invalid"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "username"}, "text": "someone@no-such-host.invalid"},
    {"op": "setText", "window": "sheet:addAccount", "find": {"identifier": "password"}, "text": "not-a-real-password"},
    {"op": "wait", "until": "idle"},
    {"op": "assert", "window": "sheet:addAccount", "expect": [ {"find": {"identifier": "testConnection"}, "enabled": true} ]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "testConnection"}},
    {"op": "accounts", "id": "settle", "text": "6000"},
    {"op": "capture", "name": "02-after-test-connection-error"},
    {"op": "assert", "window": "sheet:addAccount", "rules": ["nonBlank", "fitsScreen", "primaryButtonsVisible", "controlsReachable", "noClippedText"],
     "expect": [ {"find": {"identifier": "cancel"}, "visible": true}, {"find": {"identifier": "sync"}, "visible": true} ]},
    {"op": "resizeWindow", "window": "sheet:addAccount", "contentSize": "min"},
    {"op": "wait", "until": "idle"},
    {"op": "capture", "name": "03-min-height-with-error"},
    {"op": "assert", "window": "sheet:addAccount", "rules": ["primaryButtonsVisible", "controlsReachable", "noClippedText"],
     "expect": [ {"find": {"identifier": "cancel"}, "visible": true}, {"find": {"identifier": "testConnection"}, "visible": true} ]},
    {"op": "press", "window": "sheet:addAccount", "find": {"identifier": "cancel"}},
    {"op": "wait", "until": "noSheet:addAccount"},
    {"op": "assert", "expect": [ {"model": "accountCount", "equals": "0"} ]},
    {"op": "quit"} ] }
